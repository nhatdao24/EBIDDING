@model SMO.Service.MD.ProjectService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("Create", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> TẠO MỚI DỰ ÁN</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdBack", "Quay lại", string.Format("Forms.Close('{0}');", @Model.ViewId), "Alt+N", "arrow_back")
                            @Html.MyButton("cmdSave", "Lưu lại", string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                        </div>
                    </div>

                    <div class="row m-t-20">
                        <div class="col-xs-1"></div>
                        <div class="col-lg-7 col-xs-10">
                            <label>Tên dự án</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.NAME)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.NAME)
                            </div>

                            <label>Tên dự án tiếng anh</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.NAME_EN)
                                </div>
                            </div>

                            <label>Mã dự án/Mã dự án ERP</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.SAP_CODE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.SAP_CODE)
                            </div>

                            <label>Giám đốc dự án</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.GIAM_DOC)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.GIAM_DOC)
                            </div>

                            <label>Địa điểm</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.DIA_DIEM)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.DIA_DIEM)
                            </div>

                            <label>Địa điểm tiếng anh</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.DIA_DIEM_EN)
                                </div>
                            </div>

                            <label>Giá trị hợp đồng</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.GIA_TRI_HOP_DONG)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.GIA_TRI_HOP_DONG)
                            </div>

                            <label>Giá trị thực hiện</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.GIA_TRI_THUC_HIEN)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.GIA_TRI_THUC_HIEN)
                            </div>

                            <label>Người theo dõi</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.NGUOI_THEO_DOI)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.NGUOI_THEO_DOI)
                            </div>

                            <label>Đơn vị</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.DON_VI)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.DON_VI)
                            </div>

                            <label>Ngày bắt đầu</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.NGAY_BAT_DAU, new { @class = "datepicker" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.NGAY_BAT_DAU)
                            </div>

                            <label>Ngày kết thúc</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.NGAY_KET_THUC, new { @class = "datepicker" })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.NGAY_KET_THUC)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script type="text/javascript">
        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>
