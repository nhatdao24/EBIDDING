@model SMO.Service.MD.ProjectService

@{
    var lstUser = Model.ObjUser;
}

<div class="table-responsive">
    <table class="table table-condensed table-bordered" id="userTable">
        <thead>
            <tr>
                <th>User Name</th>
                <th>Tên</th>
                <th>Chức danh</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ObjListUserProject)
            {
               <tr onclick="RowClicked(this, '@item.USER_NAME')">
                   <td class="user-name">@item.USER_NAME</td>
                   <td>@item.User.FULL_NAME</td>
                   <td>@item.User.Title.NAME</td>
               </tr>
            }
        </tbody>
    </table>
</div>


<style>
    .table tbody tr:hover {
        background-color: #f5f5f5; 
        cursor: pointer;
    }

    .table tbody tr.selected {
        background-color: #d1ecf1;
    }
</style>