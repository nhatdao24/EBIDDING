@model SMO.Service.MD.ProjectService
@{
    var lstUser = Model.ObjUser;
}
<div style="margin-top: 30px;" class="table-responsive">
    <table class="table table-condensed table-striped table-bordered">
        <thead>
            <tr>
                <th width="20px" class="align-center">
                    <input type="checkbox" id="chkAllUserProjectForAdd" onclick="Forms.CheckAll('chkItemUserProjectForAdd', '#chkAllUserProjectForAdd')" style="margin:0;" class="filled-in" />
                    <label for="chkAllUserProjectForAdd"></label>
                </th>
                <th>User Name</th>
                <th>Tên</th>
                <th>Chức danh</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ObjUser)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="filled-in chkItemUserProjectForAdd" name="chkItemUserProjectForAdd" id="@("chkItemUserProjectForAdd" + item.USER_NAME)" modelId="@item.USER_NAME" style="margin:0;" />
                        <label for="@("chkItemUserProjectForAdd" + item.USER_NAME)"></label>
                    </td>
                    <td>@item.USER_NAME</td>
                    <td>@item.FULL_NAME</td>
                    <td>@item.Title.NAME</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{ Html.RenderPartial("Paging", Model); }




