@model SMO.Service.MD.ProjectService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var ProjectCode = ViewBag.ProjectCode;
}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" id="btn_close_modal_add_user_project" data-dismiss="modal">✖</button>
</div>
<style>
    .form-line {
        margin-top : 15px;
        margin-bottom : 10px;
    }
    
</style>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("ListUserProjectForAdd", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor( m => ProjectCode)
            <div class="card">
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons">clear_all</i> THÊM NGƯỜI DÙNG VÀO DỰ ÁN</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdSelect", "Thêm vào nhóm", "AddUserProjectToUser();", "Alt+N", "add")
                            </div>
                            <div class="input-group page-function-search">
                                <div class="form-line">
                                    @Html.TextBoxFor(m => m.SearchUserName, new { placeholder = "Tìm theo mã hoặc tên", @class = "align-center", @data_val = false })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>
                        </div>

                        <div id="divResult">

                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
         var ProjectCode = '@ViewBag.ProjectCode';
            function AddUserProjectToUser() {
                var lstSelected = '';
                $('.chkItemUserProjectForAdd').each(function () {
                    if (this.checked) {
                        lstSelected += $(this).attr('modelId') + ',';
                    }
                });
                if (lstSelected == '') {
                    alert("Bạn hãy chọn ít nhất một nhóm người dùng!");
                    return;
                }

                lstSelected = lstSelected.substring(0, lstSelected.length - 1);
                var ajaxParams = {
                    url: "@Url.Action("AddUserProjectToUser")",
                    type: 'POST',
                    dataType : 'json',
                    data: { lstUserProject: lstSelected, ProjectCode: ProjectCode }
                };
                Forms.Ajax(ajaxParams);
               
            }

            function SubmitListUserProjectForAdd() {
                Forms.SubmitForm('@Model.FormId');
            }

            $(function () {
                SubmitListUserProjectForAdd();
                Forms.CompleteUI();
                Forms.SubmitByEnter("@Model.FormId");
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
