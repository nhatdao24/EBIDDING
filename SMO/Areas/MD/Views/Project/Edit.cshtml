@model SMO.Service.MD.ProjectService
@using SMO.Core.Entities

@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}

<div id='@Model.ViewId'>
    <link href="~/Content/zTreeStyle/zTreeStyle.css" rel="stylesheet" />
    <script src="~/Scripts/Ztree/jquery.ztree.core-3.5.min.js"></script>
    <script src="~/Scripts/Ztree/jquery.ztree.excheck-3.5.min.js"></script>

    <div class="container-fluid child-content">
     
        <div class="card border-grey">
            <div class="p-t-10 p-l-10">
                @Html.MyButton("cmdBack", "Quay lại", string.Format("Forms.Close('{0}');", @Model.ViewId), "Alt+N", "arrow_back")
            </div>
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs tab-nav-right" role="tablist">
                    <li role="presentation" class="active">
                        <a href="#ThongTinDuAn" data-toggle="tab">Thông tin dự án</a>
                    </li>
                    <li role="presentation">
                        <a href="#ListUserProject" data-toggle="tab">Danh sách người dùng</a>
                    </li>
                    <li role="presentation">
                        <a href="#RightUserProject" data-toggle="tab">Phân quyền trong dự án</a>
                    </li>
                </ul>

                <div class="tab-content">

                    <div role="tabpanel" class="tab-pane fade in active" id="ThongTinDuAn">
                        @using (Ajax.BeginForm("Update", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
                        {
                            @Html.AntiForgeryToken();
                            @Html.HiddenFor(m => m.ObjDetail.CODE, new { id = "hiddenCode" })
                            <div class="page-function">
                                <div class="page-function-button m-r-20">
                                    @Html.MyButton("cmdSave", "Lưu lại", string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                                </div>
                            </div>

                            <div class="row m-t-20">
                                <div class="col-xs-1"></div>
                                <div class="col-lg-7 col-xs-10">
                                    <label>Tên dự án</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.NAME)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.NAME)
                                    </div>

                                    <label>Tên dự án tiếng anh</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.NAME_EN)
                                        </div>
                                    </div>

                                    <label>Mã dự án/Mã dự án ERP</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.SAP_CODE)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.SAP_CODE)
                                    </div>

                                    <label>Giám đốc dự án</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.GIAM_DOC)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.GIAM_DOC)
                                    </div>

                                    <label>Địa điểm</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.DIA_DIEM)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.DIA_DIEM)
                                    </div>

                                    <label>Địa điểm tiếng anh</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.DIA_DIEM_EN)
                                        </div>
                                    </div>

                                    <label>Giá trị hợp đồng</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.GIA_TRI_HOP_DONG)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.GIA_TRI_HOP_DONG)
                                    </div>

                                    <label>Giá trị thực hiện</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.GIA_TRI_THUC_HIEN)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.GIA_TRI_THUC_HIEN)
                                    </div>

                                    <label>Người theo dõi</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.NGUOI_THEO_DOI)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.NGUOI_THEO_DOI)
                                    </div>

                                    <label>Đơn vị</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.DON_VI)
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.DON_VI)
                                    </div>

                                    <label>Ngày bắt đầu</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.NGAY_BAT_DAU, new { @class = "datepicker" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.NGAY_BAT_DAU)
                                    </div>

                                    <label>Ngày kết thúc</label>
                                    <div class="form-group">
                                        <div class="form-line">
                                            @Html.MyTextBoxFor(m => m.ObjDetail.NGAY_KET_THUC, new { @class = "datepicker" })
                                        </div>
                                        @Html.ValidationMessageFor(m => m.ObjDetail.NGAY_KET_THUC)
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div role="tabpanel" class="tab-pane fade" id="ListUserProject">
                     
                    </div>

                    <div role="tabpanel" class="tab-pane fade" id="RightUserProject">

                    </div>

                </div>

            </div>
        </div>
    </div>
    <script type="text/javascript">
        function LoadTabListUserProject() {
            $("#ListUserProject").html("");
             var ajaxParams = {
                 url: "@Url.Action("ListUserProject")",
                 type: 'GET',
                 data: { ProjectCode: '@Model.ObjDetail.CODE' },
                 success: function (reponse) {
                     $("#ListUserProject").html(reponse);
                 }
             };
             Forms.Ajax(ajaxParams);
        }

        function LoadTabRightUserProject() {
            $("#RightUserProject").html("");
              var ajaxParams = {
                  url: "@Url.Action("RightUserProject")",
                  type: 'GET',
                  data: { ProjectCode: '@Model.ObjDetail.CODE' },
                  success: function (reponse) {
                      $("#RightUserProject").html(reponse);
                  }
              };
              Forms.Ajax(ajaxParams);
        }



        $(function () {
            LoadTabRightUserProject()
            LoadTabListUserProject();
            Forms.CompleteUI();
        });
    </script>
</div>

