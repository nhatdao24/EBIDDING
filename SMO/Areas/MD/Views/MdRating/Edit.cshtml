@model SMO.Service.MD.MdRatingService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}

<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("Update", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken();
        @Html.HiddenFor(m => m.ObjDetail.PKID)
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> CHỈNH SỬA XẾP LOẠI</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdBack", "Quay lại", string.Format("Forms.Close('{0}');", @Model.ViewId), "Alt+N", "arrow_back")
                            @Html.MyButton("cmdSave", "Lưu lại", string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                        </div>
                    </div>

                    <div class="row m-t-20">
                        <div class="col-xs-1"></div>
                        <div class="col-lg-7 col-xs-10">
                            <label>Điểm từ</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.FROM_VALUE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.FROM_VALUE)
                            </div>

                            <label>Điểm đến</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.TO_VALUE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.TO_VALUE)
                            </div>

                            <label>Xếp loại</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.RATING)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.RATING)
                            </div>

                            <div class="form-group">
                                <input type="checkbox" id="chkIS_BLACKLIST" style="margin:0;" class="filled-in" name="chkItem_BlackList" @(Model.ObjDetail.IS_BLACK_LIST ? "checked" : "") onchange="$('#hdd_IS_BLACK_LIST').val($(this).is(':checked'));" />
                                <label for="chkIS_BLACKLIST"></label> &nbsp;&nbsp;Black list
                                <input id="hdd_IS_BLACK_LIST" name="@Html.NameFor(x => x.ObjDetail.IS_BLACK_LIST)" type="hidden" value="@(Model.ObjDetail.IS_BLACK_LIST ? "true" : "false" )">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script type="text/javascript">
        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>




