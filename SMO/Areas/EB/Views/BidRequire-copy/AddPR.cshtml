@model SMO.Service.EB.BidRequireService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_BidRequire_AddPR";
    var listPrCode = ViewBag.LIST_PR_CODE;


}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("ListPRForAdd", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FormId)
            @Html.HiddenFor(m => m.ObjSearchPR.PROJECT_CODE)
            <input type="hidden" id="LIST_PR_CODE" name="LIST_PR_CODE" value="@ViewBag.LIST_PR_CODE"/>
            <div class="card">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">search</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="input-group page-function-search">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjSearchPR.PR_CODE, new { placeholder = "Tìm kiếm theo mã hoặc tên hàng hóa", @class = "align-center", @data_val = false, @autofocus = "true" })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>
                            <div class="col-md-6 col-xs-12">
                                <span id="notification"></span>
                            </div>
                        </div>
                        <div id="divResult">

                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">



            $(function () {
                $("#ObjSearchPR_PR_CODE").focus();
                Forms.CompleteUI();
                Forms.SubmitForm("@Model.FormId");
                Forms.SubmitByEnter("@Model.FormId");
            });
        </script>
    </div>
</div>

