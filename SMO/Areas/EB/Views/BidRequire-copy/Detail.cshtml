@model SMO.Service.EB.BidRequireService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_BidRequire_Detail";
    var user_Approve = string.Join(" | ", Model.ObjHeader.ListUser.Select(x => x.USER_NAME).ToList());

    //Kiểm tra user cần phê duyệt hay không
    var checkApprove = false;
    if (Model.ObjHeader.STATUS == EB_Status.ChoPheDuyet || Model.ObjHeader.STATUS == EB_Status.DangPheDuyet)
    {
        var userApprove = Model.ObjHeader.ListUser.FirstOrDefault(x => x.USER_NAME == ProfileUtilities.User.USER_NAME && x.IS_APPROVED == false); 
        if (userApprove == null)
        {
            checkApprove = false;
        }
        else
        {
            // Kiểm tra user level thấp hơn đã phê duyệt hay chưa
            if (Model.ObjHeader.ListUser.FirstOrDefault(x => x.C_LEVEL < userApprove.C_LEVEL && x.IS_APPROVED == false) != null)
            {
                checkApprove = false;
            }
            else
            {
                checkApprove = true;
            }
        }

    }

    //Check user có đc hủy phê duyệt hay ko
    var checkApprove2 = false;
    if ((Model.ObjHeader.STATUS == EB_Status.DaPheDuyet || Model.ObjHeader.STATUS == EB_Status.DangPheDuyet) && string.IsNullOrEmpty(Model.ObjHeader.BID_ID))
    {
        var userApprove = Model.ObjHeader.ListUser.FirstOrDefault(x => x.USER_NAME == ProfileUtilities.User.USER_NAME && x.IS_APPROVED == true);
        if (userApprove == null)
        {
            checkApprove2 = false;
        }
        else
        {
            // Kiểm tra user level cao hơn đã phê duyệt hay chưa
            if (Model.ObjHeader.ListUser.FirstOrDefault(x => x.C_LEVEL > userApprove.C_LEVEL && x.IS_APPROVED == false) != null)
            {
                checkApprove2 = false;
            }
            else
            {
                checkApprove2 = true;
            }
        }
    }
}
