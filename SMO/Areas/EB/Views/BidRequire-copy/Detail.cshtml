    <script type="text/javascript">
        function ReloadDetailPR() {
            var param = {
                url: "@Url.Action("Detail", new { id = Model.ObjHeader.CODE})",
                success: function (response) {
                    $('#@Model.ViewId').replaceWith(response);
                }
            };
            Forms.Ajax(param);
        }

        function ShowDetailPR(type, code){
            var params = {
                url : "@Url.Action("ShowDetailPR")",
                data : {type: type, code: code}
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }
        function Send() {
            if (confirm("Bạn có chắc chắn trình duyệt không?")) {
                var ajaxParams = {
                    url: "@Url.Action("Send")",
                    type: "POST",
                    data: { code: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" },
                    dataType: "json",
                    success: function (response) {
                        Message.execute(response);
                    }
                };
                Forms.Ajax(ajaxParams);
            }
        }

        function CancelApprove() {
            if (confirm("Bạn có chắc chắn hủy phê duyệt không?")) {
                var ajaxParams = {
                    url: "@Url.Action("CancelApprove")",
                    type: "POST",
                    data: { code: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" },
                    dataType: "json",
                    success: function (response) {
                        Message.execute(response);
                    }
                };
                Forms.Ajax(ajaxParams);
            }
        }

        function Cancel() {
            if (confirm("Bạn có chắc chắn hủy không?")) {
                var ajaxParams = {
                    url: "@Url.Action("Cancel")",
                    type: "POST",
                    data: { code: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" },
                    dataType: "json",
                    success: function (response) {
                        Message.execute(response);
                    }
                };
                Forms.Ajax(ajaxParams);
            }
        }

        function Reject() {
            var params = {
                url: "@Url.Action("Reject")",
                data: { id: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function Approve() {
            var params = {
                url: "@Url.Action("Approve")",
                data: { id: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function RequireUpdate() {
            var params = {
                url: "@Url.Action("RequireUpdate")",
                data: { id: '@Model.ObjHeader.CODE', viewId: "@Model.ViewId" }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        $(function () {
             if ('@Model.ObjHeader.BOQ') {
                  var dataBOQ = @Html.Raw(JsonConvert.SerializeObject(Model.ObjHeader.BOQ));
                  dataBOQ.replace(/&quot;/g, '"').replace(/\\/g, '');
                  const jsonObject = JSON.parse(dataBOQ);
                  const dataset = {
                      styles: jsonObject.styles,
                      formats: jsonObject.formats,
                      sheets: jsonObject.sheets.map(sheet => ({
                          name: sheet.name,
                          id: sheet.id,
                          data: sheet.data.map(item => ({
                              cell: item.cell,
                              value: item.value,
                              css: item.css,
                              format: item.format
                          })),
                          cols: sheet.cols, rows: sheet.rows, merged: sheet.merged
                      }))
                  };

                   spreadsheetDetail = new dhx.Spreadsheet("spreadsheetDetail", {
                       readonly: true,
                  });
                 spreadsheetDetail.parse(dataset);
                
            } else {
                  const dataset = {
                      styles: {
                          bold: {
                              "font-weight": "bold",
                          },
                          right: {
                              "justify-content": "flex-end",
                              "text-align": "right",
                          },
                      },
                      data: [

                      ],
                  };

                 spreadsheetDetail = new dhx.Spreadsheet("spreadsheetDetail", {
                     readonly: true,
                    });
                 spreadsheetDetail.parse(dataset);
                 
                
            }
            Forms.CompleteUI();
        });
    </script>
</div>
