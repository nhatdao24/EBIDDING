@model SMO.Service.EB.ReviewContractorService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewContractor_AddBid";
}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("ListBidForAdd", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObjDetail.CONTRACTOR_ID)
            @Html.HiddenFor(m => m.ObjDetail.REVIEW_ID)
            <div class="card">
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdSelect", LanguageUtilities.LangText("cmdSelect", frmCode), "AddBidToReview();", "Alt+N", "add")
                            </div>
                            <div class="input-group page-function-search">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.SearchName, new { placeholder = LanguageUtilities.LangText("lblSearch", frmCode), @class = "align-center", @data_val = false })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                @*<span class="input-group-addon" title="Tìm theo các chỉ tiêu khác" id="spShowMore" onclick="$('#spHideMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                        <i class="material-icons">expand_more</i>
                                    </span>
                                    <span class="input-group-addon" title="Ẩn các chỉ tiêu tìm kiếm khác" style="display:none;" id="spHideMore" onclick="$('#spShowMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                        <i class="material-icons">expand_less</i>
                                    </span>*@
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>
                        </div>
                        @*<div class="page-search-advance row m-l-0 m-r-0 m-b-10" style="display:none;">
                                <div class="col-md-4 col-xs-12">
                                    <label>@LanguageUtilities.LangText("lblDuAn", frmCode)</label>
                                    <div class="form-group">
                                        @Html.MyDropDownListFor(m => m.ProjectCode, SelectListUtilities.GetAllProject(true), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body", @data_val = false })
                                    </div>
                                </div>
                            </div>*@
                        @*<div class="m-b-20 m-t-20 p-l-10">
                                <input type="hidden" name="@Html.NameFor(m => m.SearchIsCheckThamGia)" id="hddThamGia" value="false" />
                                <input type="checkbox" id="chkThamGia" class="filled-in" onchange="$('#hddThamGia').val($(this).is(':checked')); SubmitListBidForAdd();" />
                                <label for="chkThamGia"></label>&nbsp;&nbsp; @LanguageUtilities.LangText("lblSelect1", frmCode)
                                &nbsp;&nbsp;&nbsp;&nbsp;
                                <input type="hidden" name="@Html.NameFor(m => m.SearchIsCheckTrungThau)" id="hddTrungThau" value="false" />
                                <input type="checkbox" id="chkTrungThau" class="filled-in" onchange="$('#hddTrungThau').val($(this).is(':checked')); SubmitListBidForAdd();" />
                                <label for="chkTrungThau"></label>&nbsp;&nbsp; @LanguageUtilities.LangText("lblSelect2", frmCode)
                            </div>*@
                        <div id="divResult">

                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
            function AddBidToReview() {
                var number = 0;
                $('.chkItemBidForAdd').each(function () {
                    if (this.checked) {
                        number++;
                        if (lstBidForAdd.filter(x => x.id == $(this).attr('modelId')).length == 0) {
                            lstBidForAdd.push({ id: $(this).attr('modelId'), name: $(this).attr('modelName'), price: $(this).attr('modelPrice')});
                        }
                    }
                });
                if (number == 0) {
                    alert("Bạn hãy chọn ít nhất một gói thầu!");
                    return;
                }
                $("#btnClose").click();
                RefreshListBid();
            }

            function SubmitListBidForAdd() {
                Forms.SubmitForm('@Model.FormId');
            }

            $(function () {
                SubmitListBidForAdd();
                Forms.CompleteUI();
                Forms.SubmitByEnter("@Model.FormId");
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal" id="btnClose">✖</button>
</div>
