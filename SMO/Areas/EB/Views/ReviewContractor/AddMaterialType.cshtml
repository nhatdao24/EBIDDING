@model SMO.Service.EB.ReviewContractorService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewContractor_AddMaterialType";
}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("ListMaterialTypeForAdd", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObjDetail.CONTRACTOR_ID)
            <div class="card">
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdSelect", LanguageUtilities.LangText("cmdSelect", frmCode), "AddMaterialTypeToReview();", "Alt+N", "add")
                            </div>
                            <div class="input-group page-function-search">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.SearchName, new { placeholder = LanguageUtilities.LangText("lblSearch", frmCode), @class = "align-center", @data_val = false })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>
                        </div>
                        
                        <div id="divResult">

                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
            function AddMaterialTypeToReview() {
                var number = 0;
                $('.chkItemMaterialTypeForAdd').each(function () {
                    if (this.checked) {
                        number++;
                        if (lstMaterialTypeForAdd.filter(x => x.id == $(this).attr('modelId')).length == 0) {
                            lstMaterialTypeForAdd.push({id: $(this).attr('modelId'), name: $(this).attr('modelName')});
                        }
                    }
                });
                if (number == 0) {
                    alert("Bạn hãy chọn ít nhất một loại hàng hóa!");
                    return;
                }
                $("#btnClose").click();
                RefreshListMaterialType();
            }

            function SubmitListMaterialTypeForAdd() {
                Forms.SubmitForm('@Model.FormId');
            }

            $(function () {
                SubmitListMaterialTypeForAdd();
                Forms.CompleteUI();
                Forms.SubmitByEnter("@Model.FormId");
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal" id="btnClose">✖</button>
</div>
