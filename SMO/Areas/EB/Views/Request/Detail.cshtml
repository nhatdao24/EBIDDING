@model SMO.Service.EB.RequestService
@using SMO.Core.Entities
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Request_Detail";
}
<style>
    .delete-style-type {
        list-style-type: none;
    }
</style>
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FormId)

        <div class="row clearfix">
            <div class="col-xs-12 col-sm-8">
                <div class="card border-grey">
                    @if (ProfileUtilities.User.IS_CHANGE_LANG)
                    {
                        <div class="divLanguage">
                            <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                        </div>
                    }
                    <div class="body div-po-detail" style="padding-top: 0px;">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">content_copy</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a></li>
                        </ul>

                        <div class="tab-content">
                            <div role="tabpanel">
                                <div class="page-function">
                                    <div class="page-function-button m-r-20">
                                        @Html.MyButton("cmdBack", LanguageUtilities.LangText("cmdBack", frmCode), string.Format("Forms.Close('{0}');", @Model.ViewId), "Alt+N", "arrow_back")
                                        @if (AuthorizeUtilities.CheckUserRight("R502"))
                                        {
                                            @Html.MyButton("cmdAdd", LanguageUtilities.LangText("cmdAdd", frmCode), string.Format("Forms.LoadAjax('{0}');", @Url.Action("CreateUserContractor", "User", new { @area = "AD", requestId = Model.ObjDetail.PKID })), "Alt+N", "person_add")
                                        }
                                    </div>
                                </div>
                                <div id="divDetail" class="m-t-20">
                                    <div class="profile-info">
                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblDiaChi", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @if (!string.IsNullOrEmpty(Model.ObjDetail.DIA_CHI))
                                                {
                                                    foreach (var item in Model.ObjDetail.DIA_CHI.Split('|'))
                                                    {
                                                        if (item != "")
                                                        {
                                                            <span>@item</span><br />
                                                        }
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblSoLuongDuAn", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @if (Model.ObjDetail.NumberOfProject != null)
                                                {
                                                    <span>@Model.ObjDetail.NumberOfProject.TEXT</span>
                                                    <br />
                                                    <span>@Model.ObjDetail.SO_LUONG_DU_AN_TEXT</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblDoanhThu3Nam", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @foreach (var item in Model.ObjDetail.ListRevenue.OrderByDescending(x => x.YEAR))
                                                {
                                                    <span>@item.YEAR - @LanguageUtilities.LangText("lblDoanhThu", frmCode): @item.VALUE.ToStringVN() @item.UNIT_CODE</span><br />
                                                }
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblKhuVucThiCong", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @foreach (var item in Model.ObjDetail.ListActiveArea.OrderByDescending(x => x.TEXT))
                                                {
                                                    <span>@item.TEXT</span><br />
                                                }
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblDanhSachGoiThau", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                <span>@Model.ObjDetail.BID_ID</span>
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblLinhVucChinh", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @foreach (var item in Model.ObjDetail.ListScope)
                                                {
                                                    <span>@(item.Scope != null ? item.Scope.TEXT : "")</span><br />
                                                }
                                                <span>@Model.ObjDetail.LINH_VUC_CHINH_TEXT</span><br />
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblOption", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                @if (Model.ObjDetail.Option != null)
                                                {
                                                    <span>@Model.ObjDetail.Option.TEXT</span>
                                                    <br />
                                                    <span>@Model.ObjDetail.TUY_CHON_TEXT</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="info-line row">
                                            <div class="col-xs-12 col-sm-4 m-b-10">
                                                <span class="col-blue-grey">@LanguageUtilities.LangText("lblGhiChu", frmCode)</span>
                                            </div>
                                            <div class="col-xs-12 col-sm-8 m-b-10">
                                                <span>@Model.ObjDetail.NOTES</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xs-12 col-sm-4">
                <div class="card m-b-30 border-grey">
                    <div class="body" id="divHeader" style="padding-top: 0px;">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle2", frmCode) @*: <span class="col-pink">@Model.ObjHeader.CODE</span>*@</a></li>
                        </ul>
                        <div class="tab-content po-info">
                            <ul>
                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblMST", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.MA_SO_THUE</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblTenCongTy", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.TEN_NGAN</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblTenCongTyFull", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.TEN_DAI</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblLoaiHinhDN", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDictionary.C_VALUE</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblQuocGia", frmCode)</span>
                                    </span>
                                    <span style="float:right">@(@Model.ObjDetail.Country != null ? Model.ObjDetail.Country.TEXT : "")</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblNguoiDaiDien", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.NGUOI_DAI_DIEN</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblEmail", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.EMAIL</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblDienThoai", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.PHONE</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblWebsite", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.WEBSITE</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblSoLuongNhanVien", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.SO_LUONG_NHAN_VIEN</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblVonDieuLe", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.VON_DIEU_LE.ToStringVN() @Model.ObjDetail.VON_DIEU_LE_UNIT</span>
                                </li>

                                <li>
                                    <span class="group-addon col-blue-grey">
                                        <i class="material-icons">settings_ethernet</i><span>&nbsp;&nbsp;@LanguageUtilities.LangText("lblNguoiNhanThongBao", frmCode)</span>
                                    </span>
                                    <span style="float:right">@Model.ObjDetail.NGUOI_NHAN_THONG_BAO</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="card m-b-30 border-grey">
                    <div class="body" id="divHeader" style="padding-top: 0px;">
                        <ul class="nav nav-tabs" role="tablist">
                            <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle3", frmCode)</a></li>
                        </ul>
                        <div class="tab-content">
                            <div id="divFileImport">
                                @if (Model.ObjDetail.FileImport != null)
                                {
                                    Html.RenderPartial("ListFile", new List<T_CM_FILE_UPLOAD>() { Model.ObjDetail.FileImport });
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/javascript">
        function CloseFormRequestDetail() {
            Forms.Close('@Model.ViewId');
        }
        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>


