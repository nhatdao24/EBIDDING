@model SMO.Service.EB.BidService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Reject_Bid_DetailBidManager";
}

<div id='@Model.ViewId'>
    <div class="modal-close">
        <button type="button" id="btn_close_modal_reject_bid" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
    </div>
    <div class="modal-body">
        <div class="content">
            <div class="card">
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div id="divResult">
                            <div class="table-responsive">
                                <label>@LanguageUtilities.LangText("lblREASON", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        <textarea name="@Html.NameFor(m => m.ObjDetail.REASON)" id="ObjDetail_REASON" rows="5" style="width: 100%;"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="page-function">
                            <div class="page-function-button m-r-20 align-center">
                                @Html.MyButton("cmdRejectBidContinue", LanguageUtilities.LangText("cmdRejectBidContinue", frmCode), "RejectBid();", "", "done_all", "border")
                                @Html.MyButton("cmdRejectBidCancel", LanguageUtilities.LangText("cmdRejectBidCancel", frmCode), "$('#btn_close_modal_reject_bid').click()", "", "cancel", "border")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function RejectBid() {
        var ajaxParams = {
            url: "@Url.Action("Reject")",
            type: "POST",
            data: { id: '@Model.ObjDetail.PKID', viewId: "@Model.ViewId", reason: $('#ObjDetail_REASON').val() },
            dataType: "json",
            success: function (response) {
                Message.execute(response);
            }
        };
        Forms.Ajax(ajaxParams);
    }
</script>


