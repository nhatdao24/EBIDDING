@model SMO.Service.EB.BidSpecService
@using SMO.Core.Entities
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Bid_DetailListSpec";
    var lang = "vi";
    if (ProfileUtilities.User != null)
    {
        lang = ProfileUtilities.User.LANGUAGE;
    }
}

<div id='@Model.ViewId' class="content m-b-50">
    <div class="row">
        <div class="col-xs-12 ">
            <div>
                @BuildSpec(Model.ObjList.Where(x => (x.PARENT_ID == "" || x.PARENT_ID == null)).OrderBy(x => x.C_ORDER).ToList(), lang)
            </div>
        </div>
    </div>

    <script type="text/javascript">
        $(function () {
            @foreach (var item in Model.ObjList)
            {
                if (item.TYPE == "TEXT")
                {
                    @: CKEDITOR.replace('txt_@Model.ObjList.IndexOf(item)',
                    @: {toolbar: 'Basic', height: '100px'});
                }
            }
            Forms.CompleteUI();
        });
    </script>
</div>


@helper BuildSpec(List<T_EB_BID_SPEC> ListSpec, string lang)
{
    foreach (var item in ListSpec)
    {
        var index = Model.ObjList.IndexOf(item);

        <div class="card border-grey m-t-5">
            <div class="body">
                @if (lang == "vi")
                {
                    <div>@item.NAME <span class="col-red">(Trọng số: @item.RATIO%)</span></div>
                    <div class="col-grey font-12 m-b-10">@item.DESCRIPTION</div>
                }
                else
                {
                    <div>@item.NAME_EN</div>
                    <div class="col-grey font-12 m-b-10">@item.DESCRIPTION_EN</div>
                }

                @if (item.TYPE == "NUMBER")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <input class="form-control" type="text" value="@Model.ObjList[index].VALUE_OF_SPEC" name="ObjList[@index].VALUE_OF_SPEC">
                        </div>
                    </div>
                }
                else if (item.TYPE == "SELECT")
                {
                    <div class="form-group">
                        <select name="ObjList[@index].VALUE_OF_SPEC" class="selectpicker show-tick dropdown form-control">
                            @foreach (var detail in item.ListDetail.OrderBy(x => x.C_ORDER))
                            {
                                if (lang == "vi")
                                {
                                    if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                    {
                                        <option selected value="@detail.PKID">@detail.VALUE</option>
                                    }
                                    else
                                    {
                                        <option value="@detail.PKID">@detail.VALUE</option>
                                    }
                                }
                                else
                                {
                                    if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                    {
                                        <option selected value="@detail.PKID">@detail.VALUE_EN</option>
                                    }
                                    else
                                    {
                                        <option value="@detail.PKID">@detail.VALUE_EN</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                }
                else if (item.TYPE == "TEXT")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <textarea id="txt_@index" name="ObjList[@index].VALUE_OF_SPEC">
                            @Model.ObjList[index].VALUE_OF_SPEC
                        </textarea>
                        </div>
                    </div>
                }

                else if (item.TYPE == "GROUP" && Model.ObjList.Count(x => x.PARENT_ID == item.PKID) > 0)
                {
                    <div class="p-l-30">
                        @BuildSpec(Model.ObjList.Where(x => x.PARENT_ID == item.PKID).OrderBy(x => x.C_ORDER).ToList(), lang)
                    </div>
                }
            </div>
        </div>
    }
}