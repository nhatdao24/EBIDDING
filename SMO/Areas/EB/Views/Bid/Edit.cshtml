                </div>
            </div>


        </div>
    }

    <script type="text/javascript">
        UploadFile.ListFile = [];

        function RemoveFile(obj, fileId) {
            if (!confirm("Bạn có chắc chắn xóa file này?")) {
                return;
            }
            $(obj).parent().parent().parent().parent().remove();
            $("#hddListFileDelete").val($("#hddListFileDelete").val() + "|" + fileId);
        }

        function SubmitForm() {
            if (!$('#@Model.FormId').valid()) {
                return false;
            }

            //$("#txtMoTaEdit").val(CKEDITOR.instances.txtMoTaEdit.getData());
            //$("#txtMoTaEdit_EN").val(CKEDITOR.instances.txtMoTaEdit_EN.getData());


            var formData = new FormData($('#@Model.FormId')[0]);


            @* ConfigViettinBank: Tách thành 2 loại hồ sơ *@

            //for (var i = 0; i < UploadFile.ListFile.length; i++) {
            //    formData.append("files", UploadFile.ListFile[i].DataFile);
            //}


            if (UploadFile.ListFile && UploadFile.ListFile.length > 0) {
                for (var i = 0; i < UploadFile.ListFile.length; i++) {
                    var fileObj = UploadFile.ListFile[i];
                    formData.append("files", fileObj.DataFile);
                    formData.append("fileGroups", fileObj.FileGroup);
                }
            }


            Forms.ShowLoading();

            var headers = {
                'RequestVerificationToken': $('#antiForgeryToken').val(),
            };

            $.ajax({
                xhr: function () {
                    var xhr = new window.XMLHttpRequest();

                    xhr.upload.addEventListener("progress", function (evt) {
                        if (evt.lengthComputable) {
                            var percentComplete = evt.loaded / evt.total;
                            percentComplete = parseInt(percentComplete * 100);
                            console.log(percentComplete);

                            if (percentComplete === 100) {
                                //alert("kakalot");
                            }
                        }
                    }, false);

                    return xhr;
                },
                type: "POST",

                @* ConfigViettinBank: Đổi chức năng Update thành UpdateVtb * @

                @*url: "@Url.Action("Update")",*@

                url: "@Url.Action("UpdateVtb")",


                data: formData,
                headers: headers,
                contentType: false,
                processData: false,
                success: function (response) {
                    Message.execute(response);
                    Forms.HideLoading();
                    setTimeout(function () {
                        $("#mnuThongTin").click();
                    }, 2500);
                },
                error: Forms.AjaxErrorHandler
            });
        };

        //$(function () {
        //    CKEDITOR.replace('txtMoTaEdit', {
        //        filebrowserImageBrowseUrl: '/FileBrowser/FileBrowser.aspx?type=images'
        //    });

        //    CKEDITOR.replace('txtMoTaEdit_EN', {
        //        filebrowserImageBrowseUrl: '/FileBrowser/FileBrowser.aspx?type=images'
        //    });

            Forms.CompleteUI();
        //});
    </script>
