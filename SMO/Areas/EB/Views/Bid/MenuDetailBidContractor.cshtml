@model SMO.Service.EB.BidService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Bid_MenuDetailBidContractor";

    var serviceBidContractor = new SMO.Service.EB.BidContractorService();

    if (Model.ObjDetail.IS_MULTIL_ROUND)
    {
        Model.ObjList = Model.CurrentRepository.Queryable().Where(x => x.PARENT_BID == Model.ObjDetail.PARENT_BID).ToList();
        var lstBidId  = Model.ObjList.Select(x => x.PKID).ToList();
        var lstBidContractor = serviceBidContractor.CurrentRepository.Queryable()
            .Where(x => lstBidId.Contains(x.BID_ID) && x.CONTRACTOR_ID == ProfileUtilities.User.CONTRACTOR_ID && x.STATUS == "AP")
            .Select(x => x.BID_ID)
            .Distinct()
            .ToList();

        Model.ObjList = Model.ObjList.Where(x => lstBidContractor.Contains(x.PKID)).ToList();
    }
}
<div id='@Model.ViewId' class="container-fluid child-content" type="typeInfoBid">
    <script src="~/Scripts/D2SCoreJS/UploadFile.js"></script>
    <div class="row">
        <div class="col-xs-12 col-sm-3 m-b-10">
            <div class="sub-sidebar">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="menu">
                    <ul class="list">
                        <li>
                            @if (ViewBag.IsOpenFromPortal == "1")
                            {
                                <a href="/Index/ChiTiet/@Model.ObjDetail.PKID" onclick="Forms.Close('@Model.ViewId');">
                                    <i class="material-icons">arrow_back</i>
                                    <span>@LanguageUtilities.LangText("mnuQuayLai", frmCode)</span>
                                </a>
                            }
                            else
                            {
                                <a href="javascript:void(0);" onclick="Forms.Close('@Model.ViewId');">
                                    <i class="material-icons">arrow_back</i>
                                    <span>@LanguageUtilities.LangText("mnuQuayLai", frmCode)</span>
                                </a>
                            }
                        </li>

                        <li id="mnuThongTin" class="active" onclick="OnClickSubMenu(this);Forms.LoadAjax({url:'@Url.Action("DetailBidContractor", "Bid", new { @id = Model.ObjDetail.PKID })',  htmlTarget: '#@Model.ViewId #divContentDetail'})">
                            <a href="javascript:void(0);">
                                <i class="material-icons">description</i>
                                <span>@LanguageUtilities.LangText("mnuThongTin", frmCode)</span>
                            </a>
                        </li>

                        <li id="mnuTraoDoiFecon" onclick="OnClickSubMenu(this);Forms.LoadAjax({url:'@Url.Action("Index", "BidContractorQuestion", new { @bidId = Model.ObjDetail.PKID })',  htmlTarget: '#@Model.ViewId #divContentDetail'})">
                            <a href="javascript:void(0);">
                                <i class="material-icons">question_answer</i>
                                <span>@LanguageUtilities.LangText("mnuTraoDoiFecon", frmCode)</span>
                            </a>
                        </li>

                        <li id="mnuNhapTieuChi" onclick="OnClickSubMenu(this);Forms.LoadAjax({url:'@Url.Action("ContractorInputSpec", "BidSpec", new { @bidId = Model.ObjDetail.PKID })',  htmlTarget: '#@Model.ViewId #divContentDetail'})">
                            <a href="javascript:void(0);">
                                <i class="material-icons">storage</i>
                                <span>@LanguageUtilities.LangText("mnuNhapTieuChi", frmCode)</span>
                            </a>
                        </li>

                        @*<li id="mnuHoSoThau" onclick="OnClickSubMenu(this);Forms.LoadAjax({url:'@Url.Action("Index", "BidSubmit", new { @bidId = Model.ObjDetail.PKID })',  htmlTarget: '#@Model.ViewId #divContentDetail'})">
                                <a href="javascript:void(0);">
                                    <i class="material-icons">dvr</i>
                                    <span>@LanguageUtilities.LangText("mnuHoSoThau", frmCode)</span>
                                </a>
                            </li>*@
                    </ul>
                </div>

            </div>
        </div>

        <div class="col-xs-12 col-sm-9">
            <div class="card border-grey m-b-10" style="padding: 5px;">
                <div class="body">
                    <div class="col-indigo font-15">
                        @if (ProfileUtilities.User.LANGUAGE == "vi")
                        {
                            <span>@Model.ObjDetail.PKID <text>-</text> @Model.ObjDetail.TEN_GOI_THAU.ToUpper()</span>
                        }
                        else
                        {
                            <span>@Model.ObjDetail.PKID <text>-</text> @Model.ObjDetail.TEN_GOI_THAU_EN.ToUpper()</span>
                        }
                        @if (Model.ObjDetail.IS_MULTIL_ROUND)
                        {
                            <br />
                            <div style="margin-top: 5px;">
                                @foreach (var item in Model.ObjList)
                                {
                                    var vdbclickAction = string.Format("CloseCurrent();Forms.LoadAjax('{0}', this);", Url.Action("MenuDetailBidContractor", new { id = item.PKID }));
                                    <div class="" style="display: inline-block; margin-right: 5px;">
                                        <input type="radio" value="@item.PKID" class="filled-in" id="rdo_@item.PKID" style="margin:0;" onclick="@vdbclickAction" name="rdoUserDecision" @(item.ROUND == Model.ObjDetail.ROUND ? "checked" : "") />
                                        <label for="rdo_@item.PKID" style="font-size: 14px; padding-left: 25px;">Vòng @item.ROUND</label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div id="divContentDetail">
                @*@{Html.RenderAction("DetailBidContractor", "Bid", new { @id = Model.ObjDetail.PKID });}*@
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function CloseCurrent() {
            Forms.Close('@Model.ViewId');
        }
        $(function () {
            // Đóng các màn hình info bid khác
            try {
                $("div[type=typeInfoBid]").each(function () {
                    if ($(this).attr("id") != '@Model.ViewId') {
                        $(this).remove();
                    }
                });
            } catch (e) {

            }


            // Mở menu theo notify
            try {
                if ("@ViewBag.IdMenu" == "") {
                    $("#@Model.ViewId #mnuThongTin").click();
                } else {
                    if ($("#@Model.ViewId #@ViewBag.IdMenu").length == 1) {
                        $("#@Model.ViewId #@ViewBag.IdMenu").click();
                    } else {
                        $("#@Model.ViewId #mnuThongTin").click();
                    }
                }
            } catch (e) {

            }
        });

        function OnClickSubMenu(obj){
            $(".sub-sidebar li").removeClass("active");
            $(obj).addClass("active");
        }
    </script>
</div>
