@model SMO.Service.MD.HhdvService
@{
    var frmCode = "frm_PREB_AddMaterial";
}
<div class="table-responsive">
    <table class="table table-condensed table-striped table-bordered font-13">
        <thead>
            <tr>
                <th>@LanguageUtilities.LangText("lblMaHangHoa", frmCode)</th>
                <th>@LanguageUtilities.LangText("lblTenHangHoa", frmCode)</th>
                <th>@LanguageUtilities.LangText("lblTrangThai", frmCode)</th>
                <th width="50px;">@LanguageUtilities.LangText("lblChon", frmCode)</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ObjList != null && Model.ObjList.Count > 0)
            {
                foreach (var item in Model.ObjList)
                {
                    <tr>
                        <td>@item.CODE</td>
                        <td>@item.NAME</td>
                        <td>@(item.ACTIVE == "Y" ? "Hoạt động" : "Không hoạt động")</td>
                        <td class="align-center">
                            <i class="material-icons col-fecon" id="ic_@item.CODE"
                               onclick="AddDetail('@item.CODE', '@item.NAME', '@item.ACTIVE', 1, 'VND', 0, '', '', '', ''); return false;"
                               style="cursor:pointer">add_circle_outline</i>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        <em>Không có dữ liệu</em>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ Html.RenderPartial("Paging", Model); }

<script type="text/javascript">
    $(function () {
        Forms.CompleteUI();
    });
</script>
