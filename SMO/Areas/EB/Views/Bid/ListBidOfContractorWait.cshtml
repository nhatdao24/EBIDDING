
@model SMO.Service.EB.BidService
@{
    var number = 1;
    var frmCode = "frm_Bid_IndexBidContractorWait";
    var lang = "vi";
    if (ProfileUtilities.User != null)
    {
        lang = ProfileUtilities.User.LANGUAGE;
    }
}

<div class="table-responsive font-13 dashboard-task-infos">
    <img src="/Content/IconFileType/excel-48.png" alt="" class="export-excel-table" onclick="ExportTableToExcel(this)" />
    <table class="table table-condensed table-striped table-bordered">
        <thead>
            <tr>
                <th>@LanguageUtilities.LangText("thTenGoiThau", frmCode)</th>
                <th>@LanguageUtilities.LangText("thGiaiDoan", frmCode)</th>
                <th class="align-center">@LanguageUtilities.LangText("thNgayMoThau", frmCode)</th>
                <th class="align-center">@LanguageUtilities.LangText("thNgayDongThau", frmCode)</th>
                <th width="120px" class="align-center">@LanguageUtilities.LangText("thConLai", frmCode)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ObjList)
            {
                number++;
                var tongNgay = (int)(item.NGAY_DONG_THAU - item.NGAY_MO_THAU).TotalDays;

                var soNgayDaQua = (int)(DateTime.Now - item.NGAY_MO_THAU).TotalDays;

                var soNgayConLai = (int)(item.NGAY_DONG_THAU - DateTime.Now).TotalDays;

                var phanTram = 0;

                if (tongNgay != 0)
                {
                    phanTram = (int)(soNgayDaQua * 100 / tongNgay);
                }

                if (tongNgay < 0)
                {
                    phanTram = 0;
                }

                var color = "bg-green";
                if (phanTram > 20)
                {
                    color = "bg-blue";
                }
                if (phanTram > 40)
                {
                    color = "bg-indigo";
                }
                if (phanTram > 60)
                {
                    color = "bg-amber";
                }
                if (phanTram > 80)
                {
                    color = "bg-deep-orange";
                }
                var vdbclickAction = string.Format("Forms.LoadAjax('{0}', this);", Url.Action("DetailBidContractorWait", new { id = item.PKID }));
                <tr>
                    <td ondblclick="@vdbclickAction">
                        <div><a href="#" onclick="@vdbclickAction">@item.PKID</a></div>
                        @if (lang == "vi")
                        {
                            <div>@item.TEN_GOI_THAU</div>
                        }
                        else
                        {
                            <div>@item.TEN_GOI_THAU_EN</div>
                        }
                    </td>
                    <td>
                        <span class="badge @Phase_Status.GetStatusColor(item.GIAI_DOAN)">@Phase_Status.GetStatusText(item.GIAI_DOAN, lang)</span>
                    </td>
                    <td class="align-center">
                        <div>@item.NGAY_MO_THAU.ToString(Global.DateTimeToStringFormat)</div>
                    </td>
                    <td class="align-center">
                        <div>@item.NGAY_DONG_THAU.ToString(Global.DateTimeToStringFormat)</div>
                    </td>
                    
                    <td style="padding-top: 0px;" class="align-center">
                        @if (item.GIAI_DOAN == Phase_Status.NopHoSo)
                        {
                            if (lang == "vi")
                            {
                                <div>@soNgayConLai Ngày</div>
                            }
                            else
                            {
                                <div>@soNgayConLai Days</div>
                            }
                            <div class="progress">
                                <div class="progress-bar @color" role="progressbar" aria-valuenow="@soNgayDaQua" aria-valuemin="0" aria-valuemax="@tongNgay" style="width: @phanTram%"></div>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{ Html.RenderPartial("Paging", Model); }
