@model SMO.Service.EB.BidContractorService
@using SMO.Repository.Implement.EB
@using SMO.Repository.Implement.MD;
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Bid_DetailListContractor";
    var lang = "vi";
    if (ProfileUtilities.User != null)
    {
        lang = ProfileUtilities.User.LANGUAGE;
    }

    var lstSubmit = Model.UnitOfWork.Repository<BidSubmitRepo>().Queryable().Where(x => x.BID_ID == Model.ObjDetail.BID_ID).ToList();
    //var lstRate = Model.UnitOfWork.Repository<MdRatingRepo>().GetAll();
}

<div id='@Model.ViewId'>
    <div class="card border-grey">
        @if (ProfileUtilities.User.IS_CHANGE_LANG)
        {
            <div class="divLanguage">
                <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
            </div>
        }
        <div class="body" style="padding-top: 0px;">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">people_outline</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a></li>
            </ul>

            <div class="tab-content">
                <div class="table-responsive">
                    <table class="table table-condensed table-striped table-bordered font-13">
                        <thead>
                            <tr>
                                <th>@LanguageUtilities.LangText("thTenNhaThau", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thTrangThai", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thTrangThaiMoiThau", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thTrangThaiNopHoSo", frmCode)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ObjList)
                            {
                                //var rate = lstRate.FirstOrDefault(x => x.RATING == item.Contractor.XEP_HANG);
                                <tr>
                                    <td>
                                        <div>
                                                <a href="#" onclick="ViewInfoContractor('@item.CONTRACTOR_ID')">@item.Contractor.TEN_NGAN</a>
                                        </div>
                                        <div class="col-blue-grey">
                                                @item.Contractor.TEN_DAI
                                        </div>
                                        <div class="col-blue-grey">
                                            Email: @item.Contractor.EMAIL
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.STATUS == "AP")
                                        {
                                            <span class="badge bg-blue">@LanguageUtilities.LangText("lblDaThamGia", frmCode)</span>
                                        }
                                        else if (item.STATUS == "RJ")
                                        {
                                            <span class="badge bg-red">@LanguageUtilities.LangText("lblTuChoi", frmCode)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-blue-grey">@LanguageUtilities.LangText("lblChoXacNhan", frmCode)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IS_SELF_JOIN)
                                        {
                                            <span class="badge bg-blue">@LanguageUtilities.LangText("lblTuThamGia", frmCode)</span>
                                        }
                                        else
                                        {
                                            if (item.EmailSent == null)
                                            {
                                                <span class="badge bg-red">@LanguageUtilities.LangText("lblChuaTao", frmCode)</span>
                                            }
                                            else
                                            {
                                                if (item.EmailSent.IS_SEND)
                                                {
                                                    <span class="badge bg-blue">@LanguageUtilities.LangText("lblDaGui", frmCode)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-red">@LanguageUtilities.LangText("lblChoGui", frmCode)</span>
                                                }
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (lstSubmit.Count(x => x.CONTRACTOR_ID == item.CONTRACTOR_ID) > 0)
                                        {
                                            <span class="badge bg-blue">@LanguageUtilities.LangText("lblAlert1", frmCode)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-blue-grey">@LanguageUtilities.LangText("lblAlert2", frmCode)</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>

    <script type="text/javascript">
        function ViewInfoContractor(id){
            var params = {
                url : "@Url.Action("ViewInfo", "Contractor", new { @area = "EB"})",
                data: { id: id }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModalLarge(params);
        }
    </script>
</div>

