@model SMO.Service.EB.ContractorProjectService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ContractorProject_Detail";

}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("Update", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObjDetail.PKID)
            @Html.HiddenFor(m => m.ObjDetail.CONTRACTOR_ID)
            <div class="card">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20">
                                @Html.MyButton("cmdSave", LanguageUtilities.LangText("cmdSave", frmCode), string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                            </div>
                        </div>

                        <div class="row m-t-20">
                            <div class="col-xs-12">
                                <label>@LanguageUtilities.LangText("lblTenDuAn", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.TEN_DU_AN)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.TEN_DU_AN)
                                </div>

                                <label>@LanguageUtilities.LangText("lblChuDauTu", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.CHU_DAU_TU)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.CHU_DAU_TU)
                                </div>

                                <label>@LanguageUtilities.LangText("lblGiaTri", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line" style="width: 70%; float:left;">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.GIA_TRI)
                                    </div>
                                    <div style="width: 29%; float: right; padding-top: 1px;">
                                        @Html.MyDropDownListFor(m => m.ObjDetail.GIA_TRI_CURRENCY, SelectListUtilities.GetCurrency(false), new { @data_live_search = "true", @class = "selectpicker show-tick" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.GIA_TRI)
                                </div>

                                <div class="clearfix"></div>
                                <label>@LanguageUtilities.LangText("lblBatDau", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.BAT_DAU, new { @class = "datepicker" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.BAT_DAU)
                                </div>

                                <label>@LanguageUtilities.LangText("lblKetThuc", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.KET_THUC, new { @class = "datepicker" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.KET_THUC)
                                </div>

                                <label>@LanguageUtilities.LangText("lblLoaiVon", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.LOAI_VON)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.LOAI_VON)
                                </div>

                                <label>@LanguageUtilities.LangText("lblPhamVi", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.MO_TA)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.MO_TA)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
            $(function () {
                Forms.CompleteUI();
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>