@model SMO.Service.EB.ContractorService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Contractor_AddContractorBid";

}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("ListContractorForAdd", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.BidId)
            @Html.HiddenFor(m => m.ViewId)

            <div class="card">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdSelect", LanguageUtilities.LangText("cmdSelect", frmCode), "AddContractorToBid();", "Alt+N", "add")
                            </div>
                            <div class="input-group page-function-search">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.TEN_NGAN, new { placeholder = LanguageUtilities.LangText("lblPlaceholder", frmCode), @class = "align-center", @data_val = false })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>
                        </div>
                        <div class="page-search-advance row m-l-0 m-r-0 m-b-10">
                            <div class="col-md-4 col-xs-12">
                                <label>@LanguageUtilities.LangText("lblLinhVucChinh", frmCode)</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.LINH_VUC_CHINH, SelectListUtilities.GetScope(), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body", @data_val = false })
                                </div>
                            </div>

                            <div class="col-md-4 col-xs-12">
                                <label>Email</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.EMAIL, new { @data_val = "false" })
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 col-xs-12">
                                <label>@LanguageUtilities.LangText("lblXepHang", frmCode)</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.XEP_HANG, SelectListUtilities.GetMdRating(), new { @data_live_search = "true", @class = "selectpicker show-tick" })
                                </div>
                            </div>

                            <div class="clearfix"></div>
                            <div class="col-md-4 col-xs-12">
                                <label>@LanguageUtilities.LangText("lblThiTruongKinhDoanh", frmCode)</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.QUOC_GIA, SelectListUtilities.GetCountry(), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                                </div>
                            </div>
                        </div>
                        <div id="divResult">

                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
            function AddContractorToBid() {
                var lstSelected = '';
                $('#@Model.ViewId .chkItemContractorForAdd').each(function () {
                    if (this.checked) {
                        lstSelected += $(this).attr('modelId') + ',';
                    }
                });
                if (lstSelected == '') {
                    alert("Bạn hãy chọn ít nhất một nhà thầu!");
                    return;
                }

                lstSelected = lstSelected.substring(0, lstSelected.length - 1);
                var ajaxParams = {
                    url: "@Url.Action("AddContractorToBid")",
                    type: 'POST',
                    dataType : 'json',
                    data: { lstContractor: lstSelected, bidId: '@Model.BidId' }
                };
                Forms.Ajax(ajaxParams);
            }

            function SubmitListContractorForAdd() {
                Forms.SubmitForm('@Model.FormId');
            }

            $(function () {
                SubmitListContractorForAdd();
                Forms.CompleteUI();
                Forms.SubmitByEnter("@Model.FormId");
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
