@model SMO.Service.EB.ReviewService
@using SMO.Repository.Common
@using SMO.Repository.Implement.EB
@using SMO.Repository.Implement.MD
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Review_Detail";
    var strCouncil = "";
    IUnitOfWork UnitOfWork = new NHUnitOfWork();
}
<div id='@Model.ViewId'>

    <div class="card border-grey m-b-10">
        <div class="body">
            @if (AuthorizeUtilities.CheckUserRight("R903") && Model.ObjDetail.CREATE_BY == ProfileUtilities.User.USER_NAME)
            {
                @Html.MyButton("cmdEditInfo", LanguageUtilities.LangText("cmdEditInfo", frmCode), string.Format("Forms.LoadAjax('{0}');", Url.Action("MenuEdit", "Review", new { @id = Model.ObjDetail.CODE })), "Alt+N", "edit")
                <text> </text>
            }
            @if (Model.ObjDetail.STATUS == Review_Status.ChuaGuiYeuCau)
            {
                if (AuthorizeUtilities.CheckUserRight("R903") && Model.ObjDetail.CREATE_BY == ProfileUtilities.User.USER_NAME)
                {
                    @Html.MyButton("cmdSendMail", LanguageUtilities.LangText("cmdSendMail", frmCode), "SendMailCouncilOfReview();", "Alt+N", "send")
                }
            }
            @if (Model.ObjDetail.STATUS == Review_Status.KhoiTao)
            {
                if (AuthorizeUtilities.CheckUserRight("R903") && Model.ObjDetail.CREATE_BY == ProfileUtilities.User.USER_NAME)
                {
                    @Html.MyButton("cmdEnd", LanguageUtilities.LangText("cmdEnd", frmCode), "EndReview();", "Alt+N", "lock")
                }
            }
        </div>
    </div>




    <div class="card border-grey">
        <div class="body" style="padding-top: 0px;">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                </li>
            </ul>

            <div class="col-blue-grey row p-l-20 p-r-20 m-l-0 m-t-30">
                <div class="col-xs-12">
                    <b>@LanguageUtilities.LangText("lblBangDanhGia", frmCode): </b> @Model.ObjDetail.CODE - @Model.ObjDetail.DESCRIPTION.ToUpper()
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblNgayTao", frmCode): </b> @Model.ObjDetail.CREATE_DATE.Value.ToString(Global.DateTimeToStringFormat)
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblNguoiTao", frmCode): </b> @Model.ObjDetail.USER_CREATE.FULL_NAME
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblNgayDanhGia", frmCode): </b> @Model.ObjDetail.EVALUATE_DATE.ToString(Global.DateTimeToStringFormat)
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblNgayKetThuc", frmCode): </b> @Model.ObjDetail.END_DATE.ToString(Global.DateTimeToStringFormat)
                </div>
                @*<div class="col-md-6 col-xs-12">
                        <b>@LanguageUtilities.LangText("lblDiemToiDa", frmCode): </b> @(Model.ObjDetail.MAX_SCORE)
                    </div>*@
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblDonVi", frmCode): </b> @(Model.ObjDetail.Organize?.NAME)
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblDuAn", frmCode): </b> @(Model.ObjDetail.Project?.NAME)
                </div>
                <div class="col-md-6 col-xs-12">
                    <b>@LanguageUtilities.LangText("lblTrangThai", frmCode): </b> <span class="badge @Review_Status.GetStatusColor(Model.ObjDetail.STATUS)">@Review_Status.GetStatusText(Model.ObjDetail.STATUS)</span>
                </div>
                <div class="col-xs-12">
                    <b>@LanguageUtilities.LangText("lblHoiDongDanhGia", frmCode): </b>
                    @foreach (var item in Model.ObjDetail.ListCouncil)
                    {
                        strCouncil += item.User.FULL_NAME.ToUpper() + " , ";
                    }
                    @if (!string.IsNullOrWhiteSpace(strCouncil))
                    {
                        strCouncil = strCouncil.Substring(0, strCouncil.Length - 3);
                        <span>@strCouncil</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-grey m-t-10">
        <div class="body" style="padding-top: 0px;">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle2", frmCode)</a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="table-responsive font-13">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>@LanguageUtilities.LangText("lblNhaThau", frmCode)</th>
                                <th>@LanguageUtilities.LangText("lblThongTinGoiThau", frmCode)</th>
                                <th>@LanguageUtilities.LangText("lblLoaiHangHoa", frmCode)</th>
                                <th>@LanguageUtilities.LangText("lblCongViec", frmCode)</th>
                                <th>@LanguageUtilities.LangText("lblGiaTri", frmCode)</th>
                                @*<th>Tỷ lệ %</th>*@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reviewContractor in Model.ObjDetail.ListContractor)
                            {
                                if (reviewContractor.ListDetail.Count > 0)
                                {
                                    foreach (var detail in reviewContractor.ListDetail)
                                    {
                                        <tr>
                                            <td>
                                                @reviewContractor.Contractor.TEN_NGAN
                                            </td>
                                            <td>
                                                <div>@detail.INFO_BID</div>
                                                @if (!string.IsNullOrWhiteSpace(detail.INFO_BID_EBID))
                                                {
                                                    foreach (var bidId in detail.INFO_BID_EBID.Split(','))
                                                    {
                                                        var find = UnitOfWork.Repository<BidRepo>().Get(bidId);
                                                        if (find != null)
                                                        {
                                                            var action = string.Format("Forms.LoadAjax('{0}', this);", Url.Action("MenuDetailBidManager", "Bid", new { id = find.PKID }));
                                                            <div><a href="#" onclick="@action">@find.PKID</a></div>
                                                        }
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(detail.MATERIAL_TYPE))
                                                {
                                                    foreach (var typeId in detail.MATERIAL_TYPE.Split(','))
                                                    {
                                                        var find = UnitOfWork.Repository<MaterialTypeRepo>().Get(typeId);
                                                        if (find != null)
                                                        {
                                                            <div>@find.TEXT</div>
                                                        }
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @detail.INFO_BID
                                            </td>
                                            <td>
                                                @detail.GIA_TRI.ToStringVN()
                                            </td>
                                            @*<td>
                                                    @detail.RATIO_IN_PROJECT.ToStringVN() %
                                                </td>*@
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td>
                                            @reviewContractor.Contractor.TEN_NGAN
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function SendMailCouncilOfReview() {
            var ajaxParams = {
                url: "@Url.Action("SendMailCouncilOfReview")",
                type: 'POST',
                dataType : 'json',
                data: { id: @Model.ObjDetail.CODE}
            };
            Forms.Ajax(ajaxParams);
        }

        function EndReview() {
            if (confirm("Bạn chắc chắn kết thúc bảng đánh giá này?")) {
                var ajaxParams = {
                    url: "@Url.Action("EndReview")",
                    type: "POST",
                    data: { id: '@Model.ObjDetail.CODE', viewId: "@Model.ViewId" },
                    dataType: "json",
                    success: function (response) {
                        Message.execute(response);
                    }
                };
                Forms.Ajax(ajaxParams);
            }
        }

        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>
