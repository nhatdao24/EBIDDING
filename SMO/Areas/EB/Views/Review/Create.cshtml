@model SMO.Service.EB.ReviewService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_Review_Create";
}
<div id='@Model.ViewId' class="container-fluid child-content">
    <script src="~/Scripts/D2SCoreJS/UploadFile.js"></script>
    @using (Ajax.BeginForm("Create", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ViewId)
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdBack", LanguageUtilities.LangText("cmdBack", frmCode), string.Format("Forms.Close('{0}');", @Model.ViewId), "", "arrow_back")
                            @Html.MyButton("cmdSave", LanguageUtilities.LangText("cmdSave", frmCode), string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                        </div>
                    </div>

                    <div class="row m-t-20">
                        <div class="col-xs-12">
                            <label>@LanguageUtilities.LangText("lblMoTa", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.DESCRIPTION)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.DESCRIPTION)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblDonVi", frmCode)</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.ORG_CODE, SelectListUtilities.GetOrganizeTypeCP(), new { @class = "selectpicker show-tick dropdown", @data_live_search = "true", @data_container = "body" })
                                @Html.ValidationMessageFor(m => m.ObjDetail.ORG_CODE)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblDuAn", frmCode)</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.PROJECT_CODE, SelectListUtilities.GetAllProject(), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                                @Html.ValidationMessageFor(m => m.ObjDetail.PROJECT_CODE)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblNgayDanhGia", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.EVALUATE_DATE, new { @class = "datetimepicker", @data_val = false })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.EVALUATE_DATE)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblNgayKetThuc", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.END_DATE, new { @class = "datetimepicker", @data_val = false })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.END_DATE)
                            </div>
                        </div>

                        @*<div class="col-xs-12 col-md-6">
                                <label>@LanguageUtilities.LangText("lblDiemToiDa", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.MAX_SCORE)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.MAX_SCORE)
                                </div>
                            </div>*@
                    </div>
                </div>
            </div>
        </div>
    }
    <script type="text/javascript">

        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>
