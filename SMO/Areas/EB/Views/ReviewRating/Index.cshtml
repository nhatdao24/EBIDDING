@model SMO.Service.EB.ReviewRatingService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    JsonSerializerSettings serializerSetting = new JsonSerializerSettings() { ReferenceLoopHandling = ReferenceLoopHandling.Ignore };
    var frmCode = "frm_ReviewRating_Index";

}
<div id='@Model.ViewId'>
    @using (Ajax.BeginForm("Update", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.FormId)
        @Html.HiddenFor(model => model.ObjDetail.REVIEW_ID, new { @data_bind = "value: ObjDetail.REVIEW_ID" })
        <div class="card border-grey">
            @if (ProfileUtilities.User.IS_CHANGE_LANG)
            {
                <div class="divLanguage">
                    <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                </div>
            }
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a></li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @*@Html.MyButton("cmdAdd", LanguageUtilities.LangText("cmdAdd", frmCode), string.Format("CreateSpec();"), "", "add")*@
                            @Html.MyButton("cmdUpdate", LanguageUtilities.LangText("cmdUpdate", frmCode), "SubmitRating();", "", "done_all")
                            @*@Html.MyButton("cmdChoose", LanguageUtilities.LangText("cmdChoose", frmCode), "AddFromMD();", "", "assignment")*@
                        </div>
                    </div>

                    <div id="divResult" style="overflow-x: auto;">
                        <div id="divDetailSpec">
                            <span class="waves-effect btn-outline-primary btn m-b-10" onclick="AddDetail();">
                                <span>Thêm</span>
                            </span>
                            <div style="border: 1px solid #e4e4e4; min-height: 200px" class="table-responsive">
                                <table class="table " style="margin-bottom:0px;">
                                    <thead>
                                        <tr>
                                            <th class="align-center">@LanguageUtilities.LangText("thGiaTri", frmCode)</th>
                                            <th width="100px" class="align-center">@LanguageUtilities.LangText("thXepHang", frmCode)</th>
                                            <th width="10px" class="align-center">#</th>
                                        </tr>
                                    </thead>
                                    <tbody data-bind="template: { name: 'RowDetailTemplate', foreach: ObjList }"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script type="text/html" id="RowDetailTemplate">
        <tr>
            <td>
                <div class="form-group" style="margin-bottom:0;">
                    <div class="form-line" style="float:left; width: 42%; margin-right:2px;">
                        <input type="text" data-bind="value: FROM_VALUE" class="form-control align-center" placeholder="Điểm từ" />
                    </div>

                    <div class="form-line" style="float:left; width: 42%; margin-right:2px;">
                        <input type="text" data-bind="value: TO_VALUE" class="form-control align-center" placeholder="Điểm đến" />
                    </div>
                </div>
            </td>
            <td>
                <div class="form-group" style="margin-bottom:0;">
                    <div class="form-line">
                        <input type="hidden" data-bind="value: REVIEW_ID" value="@Model.ObjDetail.REVIEW_ID" />
                        <input type="text" data-bind="value: RATING" class="form-control align-center" placeholder="Vd: A" />
                    </div>
                </div>
            </td>
            <td>
                <i class="material-icons col-red" onclick="RemoveDetail(this);" data-bind="attr: {order : C_ORDER}" style="cursor:pointer">remove_circle_outline</i>
            </td>
        </tr>
    </script>

    <script src="~/Scripts/PO/ko.model.ReviewRating.js"></script>
    <script type="text/javascript">
        function SubmitRating() {
            @*if (!$('#@Model.FormId').valid()) {
                return false;
            }*@

            //if (model.ObjList().length == 0) {
            //    Message.func.AlertDanger({Message : {Code : "", Message : "Chưa có thông tin các item !"}});
            //    return;
            //}

            model.ViewId = '@Model.ViewId';
            var ajaxParams = {
                url: '@Url.Action("CreateOrUpdate")',
                type: 'POST',
                dataType: 'JSON',
                data: ko.toJS(model)
            };
            Forms.Ajax(ajaxParams);
        };

        function AddDetail() {
            model.AddDetail(number, 0, 0, "", "", "@Model.ObjDetail.REVIEW_ID");
            number = number + 1;
            Forms.CompleteUI();
        }

        var Header = ko.mapping.fromJS(@Html.Raw(JsonConvert.SerializeObject(Model.ObjDetail, serializerSetting)));
        var number = 1;
        var model = new Model();
        model.ObjDetail = Header;
        var lstDetail = @Html.Raw(JsonConvert.SerializeObject(Model.ObjList.OrderBy(x => x.C_ORDER), serializerSetting));
        $.each(lstDetail, function () {
            model.ObjList.push(new Detail(number, this.FROM_VALUE, this.TO_VALUE, this.RATING, this.PKID, this.REVIEW_ID));
            number = number + 1;
        });

        $(function () {
            ko.applyBindings(model, document.getElementById('@Model.ViewId'));
            Forms.CompleteUI();
        });
    </script>
</div>


