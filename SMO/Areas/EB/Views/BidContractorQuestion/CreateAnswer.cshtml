@model SMO.Service.EB.BidContractorAnswerService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_BidContractorQuestion_CreateAnswer";

}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal" id="btnClose">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("CreateAnswer", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObjDetail.QUESTION_ID)
            <div class="card">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">question_answer</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20">
                                @Html.MyButton("cmdCreateAnswer", @LanguageUtilities.LangText("cmdCreateAnswer", frmCode), "CreateAnswer();", " ", "done_all")
                                @Html.MyButton("cmdFileAnswer", @LanguageUtilities.LangText("cmdFileAnswer", frmCode), "UploadFile.InsertFile('#divPreviewFileAnswer','fileAnswer');", " ", "attach_file")
                            </div>
                        </div>

                        <div>
                            <div id="divPreviewFileAnswer">

                            </div>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextAreaFor(m => m.ObjDetail.CONTENTS, new { id = "txtAnswer"})
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <script type="text/javascript">
            function CreateAnswer() {
                $("#txtAnswer").val(CKEDITOR.instances.txtAnswer.getData());
                var formData = new FormData($('#@Model.FormId')[0]);

                for (var i = 0; i < UploadFile.ListFile.length; i++) {
                    if (UploadFile.ListFile[i].FileGroup == "fileAnswer") {
                        formData.append("files", UploadFile.ListFile[i].DataFile);
                    }
                }

                Forms.ShowLoading();

                var headers = {
                    'RequestVerificationToken': $('#antiForgeryToken').val(),
                };
                $.ajax({
                    xhr: function () {
                        var xhr = new window.XMLHttpRequest();

                        xhr.upload.addEventListener("progress", function (evt) {
                            if (evt.lengthComputable) {
                                var percentComplete = evt.loaded / evt.total;
                                percentComplete = parseInt(percentComplete * 100);
                                console.log(percentComplete);

                                if (percentComplete === 100) {
                                    //alert("kakalot");
                                }
                            }
                        }, false);

                        return xhr;
                    },
                    type: "POST",
                    url: "@Url.Action("CreateAnswer")",
                    data: formData,
                    headers: headers,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        UploadFile.ClearFile("fileAnswer");
                        Message.execute(response);
                        $("#btnClose").click();
                        Forms.HideLoading();
                    },
                    error: Forms.AjaxErrorHandler
                });
            }

            $(function () {
                UploadFile.ListFile = [];
                CKEDITOR.replace('txtAnswer', {
                    toolbar: 'Basic'
                });
                Forms.CompleteUI();
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
