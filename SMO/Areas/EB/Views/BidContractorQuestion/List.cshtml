@model SMO.Service.EB.BidContractorQuestionService
@{
    var number = 1;
    var frmCode = "frm_BidContractorQuestion_Index";

}

@if (Model.ObjList.Count() == 0)
{
    <div class="card m-t-10 border-grey">
        <div class="body align-center" style="height: 300px;">
            <h4>@LanguageUtilities.LangText("lblKhongTimThay", frmCode)!</h4>
        </div>
    </div>
}

@foreach (var question in Model.ObjList.OrderByDescending(x => x.CREATE_DATE))
{
    number = 1;
    <div class="card m-t-10 border-grey">
        <div class="body">
            <div class="conversation">
                <div class="question">
                    @if (question.TYPE == UserType.NhaThau)
                    {
                        <div class="user">@ProfileUtilities.User.Contractor.TEN_NGAN ► CTD</div>
                    }
                    else
                    {
                        <div class="user">CTD ► @ProfileUtilities.User.Contractor.TEN_NGAN</div>
                    }
                    <div class="time">
                        @question.CREATE_DATE.ToString()
                        @if (!question.IS_BID_CLOSE.Value)
                        {
                            <span>(@LanguageUtilities.LangText("lblGDMoThau2", frmCode))</span>
                        }
                        else
                        {
                            <span>(@LanguageUtilities.LangText("lblGDDongThau2", frmCode))</span>
                        }
                    </div>

                    <div class="content">
                        @Html.Raw(question.CONTENTS)
                    </div>
                    <div class="reply">
                        @if (question.TYPE == UserType.NB && ProfileUtilities.User.USER_TYPE == UserType.NhaThau)
                        {
                            <a href="#" onclick="AddAnswer('@question.PKID');">@LanguageUtilities.LangText("lblTraLoi", frmCode)</a>
                        }
                    </div>
                    @if (question.ListFile.Count > 0)
                    {
                        <div class="file">
                            @{Html.RenderPartial("ListFile", question.ListFile.Select(x => x.FileUpload).ToList());} 
                        </div>
                    }

                </div>

                @{ 
                    var lstAnswer = question.ListAnswer.ToList();
                    if (question.IS_ALL)
                    {
                        lstAnswer = question.ListAnswer.Where(x => x.CONTRACTOR_ID == ProfileUtilities.User.CONTRACTOR_ID).ToList();
                    }
                }
                @if (lstAnswer.Count > 0)
                {
                    <div class="answer">
                        @foreach (var answer in lstAnswer.OrderByDescending(x => x.CREATE_DATE))
                        {
                            if (question.TYPE == UserType.NhaThau)
                            {
                                <div class="user">CTD</div> <div class="time">@answer.CREATE_DATE.ToString()</div>
                            }
                            else
                            {
                                <div class="user">@ProfileUtilities.User.Contractor.TEN_NGAN</div> <div class="time">@answer.CREATE_DATE.ToString()</div>
                            }
                            <div class="content">
                                @Html.Raw(answer.CONTENTS)
                            </div>

                            if (answer.ListFile.Count > 0)
                            {
                                <div class="file">
                                    @{Html.RenderPartial("ListFile", answer.ListFile.Select(x => x.FileUpload).ToList());}
                                </div>
                            }

                            if (number < lstAnswer.Count() && lstAnswer.Count() > 1)
                            {
                                <hr />
                                }
                                number++;
                            }
                    </div>
                }
            </div>
        </div>
    </div>
        
}

