@model SMO.Service.EB.ContractorContactService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ContractorContact_Create";

}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        @using (Ajax.BeginForm("Create", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ObjDetail.CONTRACTOR_ID)
            <div class="card">
                @if (ProfileUtilities.User.IS_CHANGE_LANG)
                {
                    <div class="divLanguage">
                        <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                    </div>
                }
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="page-function">
                            <div class="page-function-button m-r-20">
                                @Html.MyButton("cmdSave", LanguageUtilities.LangText("cmdSave", frmCode), string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                            </div>
                        </div>

                        <div class="row m-t-20">
                            <div class="col-xs-12">
                                <label>@LanguageUtilities.LangText("lblQuocGia", frmCode)</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.COUNTRY_CODE, SelectListUtilities.GetCountry(), new { @data_live_search = "true", @class = "selectpicker show-tick" })
                                    @Html.ValidationMessageFor(m => m.ObjDetail.COUNTRY_CODE)
                                </div>

                                <label>@LanguageUtilities.LangText("lblTenNguoiLL", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.FULL_NAME)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.FULL_NAME)
                                </div>

                                <label>@LanguageUtilities.LangText("lblEmail", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.EMAIL)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.EMAIL)
                                </div>

                                <label>@LanguageUtilities.LangText("lblPhone", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.PHONE)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.PHONE)
                                </div>

                                <label>@LanguageUtilities.LangText("lblNotes", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.NOTES)
                                    </div>
                                    @Html.ValidationMessageFor(m => m.ObjDetail.NOTES)
                                </div>

                                <div class="form-group">
                                    <input type="checkbox" id="chkIS_DEFAULT" style="margin:0;" class="filled-in" name="chkItem_Default" @(Model.ObjDetail.IS_DEFAULT ? "checked" : "") onchange="$('#hdd_IS_DEFAULT').val($(this).is(':checked'));" />
                                    <label for="chkIS_DEFAULT"></label> &nbsp;&nbsp;@LanguageUtilities.LangText("lblIS_DEFAULT", frmCode)
                                    <input id="hdd_IS_DEFAULT" name="@Html.NameFor(x => x.ObjDetail.IS_DEFAULT)" type="hidden" value="@(Model.ObjDetail.IS_DEFAULT ? "true" : "false" )">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div> 
        }

        <script type="text/javascript">
            $(function () {
                Forms.CompleteUI();
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>