@model SMO.Service.EB.BidContractorService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_BidContractor_Index";
    var bidId = Model.ObjDetail.BID_ID;
    var bidService = new SMO.Service.EB.BidService();
    var bid = bidService.CurrentRepository.Get(bidId);
}
<div id='@Model.ViewId'>
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken();
        @Html.HiddenFor(m => m.ObjDetail.BID_ID)
        @Html.HiddenFor(m => m.ViewId)

        <div class="card border-grey">
            @if (ProfileUtilities.User.IS_CHANGE_LANG)
            {
                <div class="divLanguage">
                    <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                </div>
            }
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    @*ConfigViettinBank: Tiêu đề DANH SÁCH NHÀ THẦU sửa thành Danh sách nhà thầu nhận HSYC*@
                    <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">people_outline</i> @LanguageUtilities.LangText("lblTitleVtb", frmCode)</a></li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @if (bid.STATUS == "01" || bid.STATUS == "04")
                            {
                                @Html.MyButton("cmdAddContractor", @LanguageUtilities.LangControl("cmdAddContractor", frmCode), "AddContractor();", " ", "add")
                                @Html.MyButton("cmdRemoveContractor", @LanguageUtilities.LangControl("cmdRemoveContractor", frmCode), "RemoveContractor();", " ", "delete")
                            }
                        </div>
                    </div>

                    <div id="divResult">
                    </div>
                </div>
            </div>
        </div>
                            }

    <script type="text/javascript">
        function AddContractor() {
            var bidId = '@Model.ObjDetail.BID_ID';
            var params = {
                url : "@Url.Action("AddContractorBid", "Contractor")",
                data: { bidId: bidId }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function RemoveContractor() {
            if (!confirm("Bạn có chắc chắn xóa không?")) {
                return;
            }
            var lstSelected = '';
            $('#@Model.ViewId .chkItemContractorOfBid').each(function () {
                if (this.checked) {
                    lstSelected += $(this).attr('modelId') + ',';
                }
            });
            if (lstSelected == '') {
                alert("Bạn hãy chọn ít nhất một nhà thầu!");
                return;
            }

            lstSelected = lstSelected.substring(0, lstSelected.length - 1);
            var ajaxParams = {
                url: "@Url.Action("DeleteContractorOfBid")",
                type: 'POST',
                dataType : 'json',
                data: { lstContractor: lstSelected}
            };
            Forms.Ajax(ajaxParams);
        }


        function SubmitListContractorOfBid() {
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            $(".inputMask").inputmask();
            Forms.CompleteUI();
        });
    </script>
</div>
