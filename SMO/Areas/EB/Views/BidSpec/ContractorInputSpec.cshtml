@helper BuildSpec(List<T_EB_BID_SPEC> ListSpec, T_EB_BID bid, string lang)
{
    var msgRequired = "THÔNG TIN NÀY BẮT BUỘC NHẬP!";
    if (lang != "vi")
    {
        msgRequired = "THIS INFORMATION IS REQUIRED!";
    }
    foreach (var item in ListSpec)
    {
        var colRed = "";
        var textBold = "";
        if (item.MD_PKID == Global.IdSpecPrice)
        {
            colRed = "col-red";
            textBold = "font-bold";
        }
        var index = Model.ObjList.IndexOf(item);

        <div class="m-b-5 m-t-10">
            @if (lang == "vi")
            {
                <div class="@colRed @textBold">@item.NAME</div>
                <div class="col-grey font-12 m-b-10">@item.DESCRIPTION</div>
            }
            else
            {
                <div class="col-red font-bold">@item.NAME_EN</div>
                <div class="col-grey font-12 m-b-10">@item.DESCRIPTION_EN</div>
            }
            @if (bid.NGAY_DONG_THAU >= DateTime.Now)
            {
                if (item.TYPE == "NUMBER")
                {
                    <div class="form-group kkk">
                        <div class="form-line">

                            @if (item.MD_PKID == "a90cb897-0e4a-40c9-8be9-f31005b51c18")
                            {
                                <input data-val="true"
                                       placeholder="Nhập giá trị chào thầu..."
                                       style="border-color: #28a745; box-shadow: 0 0 5px rgba(128, 128, 128, 0.6); "
                                       data-val-required="@msgRequired" class="form-control inputMask @colRed @textBold" type="text"
                                       onchange="ValidateNumber(this,'@item.PKID')"
                                       value="@(string.IsNullOrWhiteSpace(Model.ObjList[index].VALUE_OF_SPEC) ? "" : Model.ObjList[index].VALUE_OF_SPEC)"
                                       name="ObjList[@index].VALUE_OF_SPEC"
                                       maxlength="20"
                                       data-inputmask="'alias': 'decimal', 'groupSeparator': '.', 'radixPoint' :',', 'autoGroup': true, 'autoUnmask': true, 'rightAlign': false">
                            }
                            else
                            {

                                <input data-val="true"
                                       placeholder="Nhập giá trị..."
                                       style="border-color: #28a745; box-shadow: 0 0 5px rgba(128, 128, 128, 0.3); "
                                       data-val-required="@msgRequired" class="form-control inputMask @colRed @textBold" type="text"
                                       onchange="ValidateNumber(this,'@item.PKID')"
                                       value="@(string.IsNullOrWhiteSpace(Model.ObjList[index].VALUE_OF_SPEC) ? "" : Model.ObjList[index].VALUE_OF_SPEC)"
                                       name="ObjList[@index].VALUE_OF_SPEC"
                                       maxlength="20"
                                       data-inputmask="'alias': 'decimal', 'groupSeparator': '.', 'radixPoint' :',', 'autoGroup': true, 'autoUnmask': true, 'rightAlign': false">
                            }
                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                            <span for="ObjList[@index].VALUE_OF_SPEC"></span>
                        </span>
                        <span class="field-validation-error" id="span_@item.PKID" style="display:none;"><span>Vui lòng nhập giá trị kiểu số.</span></span>
                    </div>
                }
                else if (item.TYPE == "SELECT")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <select data-val="true" data-val-required="@msgRequired" name="ObjList[@index].VALUE_OF_SPEC" class="selectpicker show-tick dropdown form-control">
                                <option value=""></option>
                                @if (lang == "vi")
                                {
                                    foreach (var detail in item.ListDetail.OrderBy(x => x.C_ORDER))
                                    {
                                        if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                        {
                                            <option selected value="@detail.PKID">@detail.VALUE</option>
                                        }
                                        else
                                        {
                                            <option value="@detail.PKID">@detail.VALUE</option>
                                        }
                                    }
                                }
                                else
                                {
                                    foreach (var detail in item.ListDetail.OrderBy(x => x.C_ORDER))
                                    {
                                        if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                        {
                                            <option selected value="@detail.PKID">@detail.VALUE_EN</option>
                                        }
                                        else
                                        {
                                            <option value="@detail.PKID">@detail.VALUE_EN</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                        </span>
                    </div>
                }
                else if (item.TYPE == "TEXT")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <textarea data-val="true" data-val-required="@msgRequired" style="width: 100%" rows="5" name="ObjList[@index].VALUE_OF_SPEC">
                                        @Model.ObjList[index].VALUE_OF_SPEC
                                    </textarea>
                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                        </span>
                    </div>
                }

                else if (item.TYPE == "GROUP" && Model.ObjList.Count(x => x.PARENT_ID == item.PKID && x.IS_NOT_SHOW_CONTRACTOR == false) > 0)
                {
                    <div class="p-l-30">
                        @BuildSpec(Model.ObjList.Where(x => x.PARENT_ID == item.PKID && x.IS_NOT_SHOW_CONTRACTOR == false).OrderBy(x => x.C_ORDER).ToList(), bid, lang)
                    </div>
                }
            }
            else
            {
                if (item.TYPE == "NUMBER")
                {
                    <div class="form-group">
                        <div class="form-line">

                            @if (item.MD_PKID == "a90cb897-0e4a-40c9-8be9-f31005b51c18")
                            {
                                <input data-val="true" readonly data-val-required="@msgRequired" class="form-control inputMask @colRed @textBold" type="text"
                                       placeholder="Nhập giá trị chào thầu..."
                                       style="border-color: #28a745; box-shadow: 0 0 5px rgba(128, 128, 128, 0.3); "
                                       onchange="ValidateNumber(this,'@item.PKID')"
                                       value="@(string.IsNullOrWhiteSpace(Model.ObjList[index].VALUE_OF_SPEC) ? "0" : Model.ObjList[index].VALUE_OF_SPEC)"
                                       name="ObjList[@index].VALUE_OF_SPEC"
                                       data-inputmask="'alias': 'decimal', 'groupSeparator': '.', 'radixPoint' :',', 'autoGroup': true, 'autoUnmask': true, 'rightAlign': false">
                            }
                            else
                            {

                                <input data-val="true" readonly data-val-required="@msgRequired" class="form-control inputMask @colRed @textBold" type="text"
                                       placeholder="Nhập giá trị..."
                                       style="border-color: #28a745; box-shadow: 0 0 5px rgba(128, 128, 128, 0.3); "
                                       onchange="ValidateNumber(this,'@item.PKID')"
                                       value="@(string.IsNullOrWhiteSpace(Model.ObjList[index].VALUE_OF_SPEC) ? "0" : Model.ObjList[index].VALUE_OF_SPEC)"
                                       name="ObjList[@index].VALUE_OF_SPEC"
                                       data-inputmask="'alias': 'decimal', 'groupSeparator': '.', 'radixPoint' :',', 'autoGroup': true, 'autoUnmask': true, 'rightAlign': false">
                            }

                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                            <span for="ObjList[@index].VALUE_OF_SPEC"></span>
                        </span>
                        @*<span class="field-validation-error" id="span_@item.PKID" style="display:none;"><span >Vui lòng nhập giá trị kiểu số.</span></span>*@
                    </div>
                }
                else if (item.TYPE == "SELECT")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <select disabled data-val="true" data-val-required="@msgRequired" name="ObjList[@index].VALUE_OF_SPEC" class="selectpicker show-tick dropdown form-control">
                                <option value=""></option>
                                @if (lang == "vi")
                                {
                                    foreach (var detail in item.ListDetail.OrderBy(x => x.C_ORDER))
                                    {
                                        if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                        {
                                            <option selected value="@detail.PKID">@detail.VALUE</option>
                                        }
                                        else
                                        {
                                            <option value="@detail.PKID">@detail.VALUE</option>
                                        }
                                    }
                                }
                                else
                                {
                                    foreach (var detail in item.ListDetail.OrderBy(x => x.C_ORDER))
                                    {
                                        if (detail.PKID == Model.ObjList[index].VALUE_OF_SPEC)
                                        {
                                            <option selected value="@detail.PKID">@detail.VALUE_EN</option>
                                        }
                                        else
                                        {
                                            <option value="@detail.PKID">@detail.VALUE_EN</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                        </span>
                    </div>
                }
                else if (item.TYPE == "TEXT")
                {
                    <div class="form-group">
                        <div class="form-line">
                            <textarea readonly data-val="true" data-val-required="@msgRequired" style="width: 100%" rows="5" name="ObjList[@index].VALUE_OF_SPEC">
                                        @Model.ObjList[index].VALUE_OF_SPEC
                                    </textarea>
                        </div>
                        <span class="field-validation-error" data-valmsg-for="ObjList[@index].VALUE_OF_SPEC" data-valmsg-replace="true">
                        </span>
                    </div>
                }

                else if (item.TYPE == "GROUP" && Model.ObjList.Count(x => x.PARENT_ID == item.PKID && x.IS_NOT_SHOW_CONTRACTOR == false) > 0)
                {
                    <div class="p-l-30">
                        @BuildSpec(Model.ObjList.Where(x => x.PARENT_ID == item.PKID && x.IS_NOT_SHOW_CONTRACTOR == false).OrderBy(x => x.C_ORDER).ToList(), bid, lang)
                    </div>
                }
            }

        </div>
    }
}