@model SMO.Service.EB.BidRequireService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_RequireUpdate_BidRequire";
}

<div id='@Model.ViewId'>
    <div class="modal-close">
        <button type="button" id="btn_close_modal_requireUpdate_bidRequire" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
    </div>
    <div class="modal-body">
        <div class="content">
            <div class="card">
                <div class="body" style="padding-top: 0px;">
                    <ul class="nav nav-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div id="divResult">
                            <div class="table-responsive">
                                <label>@LanguageUtilities.LangText("lblREASON", frmCode)</label>
                                <div class="form-group">
                                    <div class="form-line">
                                        <textarea name="@Html.NameFor(m => m.ObjHeader.REASON)" id="ObjHeader_REASON" rows="5" style="width: 100%;" required></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="page-function">
                            <div class="page-function-button m-r-20 align-center">
                                @Html.MyButton("cmdRequireUpdateBibRequireContinue", LanguageUtilities.LangText("cmdRequireUpdateBibRequireContinue", frmCode), "RequireUpdateBidRequire();", "", "done_all", "border")
                                @Html.MyButton("cmdRequireUpdateRequireCancel", LanguageUtilities.LangText("cmdRequireUpdateRequireCancel", frmCode), "$('#btn_close_modal_requireUpdate_bidRequire').click()", "", "cancel", "border")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function RequireUpdateBidRequire() {
        var reason = $('#ObjHeader_REASON').val();
        if (reason == null || reason == "") {
            Message.func.AlertDanger({ Message: { Code: "", Message: "Chưa nhập lý do yêu cầu cập nhật!" } });
            return;
        }
        if (confirm("Bạn có chắc chắn yêu cầu cập nhật không?")) {
            var ajaxParams = {
                url: "@Url.Action("RequireUpdate")",
                type: "POST",
                data: { code: '@Model.ObjHeader.CODE', viewId: "@ViewBag.ViewId", reason: $('#ObjHeader_REASON').val() },
                dataType: "json",
                success: function (response) {
                    Message.execute(response);
                }
            };
            Forms.Ajax(ajaxParams);
        }
    }
</script>



