@model SMO.Service.EB.BidRequireService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_BidRequire_Index";

}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken();
        @Html.HiddenFor(m => m.FormId)
        <div class="card border-grey">
            @if (ProfileUtilities.User.IS_CHANGE_LANG)
            {
                <div class="divLanguage">
                    <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                </div>
            }
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20" style="float:left">
                            @Html.MyButton("cmdAdd", LanguageUtilities.LangText("cmdAdd", frmCode), string.Format("Forms.LoadAjax('{0}');", @Url.Action("Create")), "Alt+N", "add")
                        </div>
                        <div class="input-group page-function-search" style="margin-bottom: 7px !important">
                            <div class="form-line">
                                @Html.MyTextBoxFor(m => m.ObjDetail.NAME, new { placeholder = LanguageUtilities.LangText("lblPlaceHolder", frmCode), @class = "align-center", @data_val = false })
                            </div>

                            <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                <i class="material-icons">search</i>
                            </span>
                            <span class="input-group-addon" title="Tìm theo các chỉ tiêu khác" id="spShowMore" onclick="$('#spHideMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                <i class="material-icons">expand_more</i>
                            </span>
                            <span class="input-group-addon" title="Ẩn các chỉ tiêu tìm kiếm khác" style="display:none;" id="spHideMore" onclick="$('#spShowMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                <i class="material-icons">expand_less</i>
                            </span>
                            <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                <i class="material-icons">refresh</i>
                            </span>
                        </div>
                    </div>
                    <div class="page-search-advance row m-l-0 m-r-0 m-b-10" style="display:none;">
                        <div class="col-md-4 col-xs-12">
                            <label>@LanguageUtilities.LangText("lblNgayTao", frmCode)</label>
                            <div class="input-group form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.CREATE_DATE, new { @class = "datepicker", @data_val = false })
                                </div>
                                <span class="input-group-addon">
                                    <i class="material-icons">date_range</i>
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12">
                            <label>@LanguageUtilities.LangText("lblNguoiTrinh", frmCode)</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.CREATE_BY, SelectListUtilities.GetAllUserFecon(true), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12">
                            <label>@LanguageUtilities.LangText("lblNguoiDuyet", frmCode)</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.USER_APPROVE, SelectListUtilities.GetAllUserFecon(true), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body", @multiple = "@multiple" })
                            </div>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-3 col-xs-12">
                            <label>Dự án</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.PROJECT_CODE, SelectListUtilities.GetProjectOfUser(), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Gói thầu</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.PACKAGE_CODE, SelectListUtilities.GetAllPackage(), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Phạm vi công việc</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.SCOPE_TYPE_CODE, SelectListUtilities.GetScopeType(), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Loại hình</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.ObjDetail.BID_TYPE_CODE, SelectListUtilities.GetBidType("vi", true), new { @data_val = false, @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>
                    </div>
                    <div id="divResult">

                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/javascript">
        function SubmitIndex() {
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.SubmitByEnter("@Model.FormId");
            Forms.CompleteUI();
        });
    </script>
</div>
