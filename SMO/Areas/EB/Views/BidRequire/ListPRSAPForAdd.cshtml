@model SMO.Service.PR.PRSAPService
@{ 
    var frmCode = "frm_BidRequire_AddPR";

}
@{ Html.RenderPartial("Paging", Model); }

<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th class="align-center">@LanguageUtilities.LangText("thChiTiet", frmCode)</th>
                <th class="align-center">@LanguageUtilities.LangText("thMaYeuCau", frmCode)</th>
                <th>@LanguageUtilities.LangText("thTenYeuCau", frmCode)</th>
                <th class="align-center">@LanguageUtilities.LangText("thNgayYeuCau", frmCode)</th>
                <th>@LanguageUtilities.LangText("thNguoiYeuCau", frmCode)</th>
                <th class="align-center">#</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ObjList)
            {
                <tr>
                    <td class="align-center">
                        <i class="material-icons col-fecon" onclick="$(this).parent().parent().next().toggle();" style="cursor:pointer">arrow_drop_down_circle</i>
                    </td>
                    <td class="align-center">@item.CODE</td>
                    <td>@item.REQUIRE_NAME</td>
                    <td class="align-center">@item.REQUIRE_DATE</td>
                    <td>@item.REQUIRE_USER</td>
                    <td class="align-center">
                        <i class="material-icons col-fecon" onclick="@($"AddPR('{item.CODE}','{item.REQUIRE_NAME}','SAP',[]);"); $(this).html('check')" style="cursor:pointer">add_circle_outline</i>
                    </td>
                </tr>
                <tr style="display: none">
                    <td colspan="6">
                        <table class="table">
                            <tr>
                                <th>@LanguageUtilities.LangText("thMaItem", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thTenItem", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thSoLuong", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thDonGia", frmCode)</th>
                                <th>@LanguageUtilities.LangText("thTongTien", frmCode)</th>
                            </tr>
                            @foreach (var detail in item.ListDetail)
                            {
                                <tr>
                                    <td>@detail.MATERIAL_CODE.TrimStart('0')</td>
                                    <td>@detail.MATERIAL_NAME</td>
                                    <td>@detail.QUANTITY.ToStringVN() @detail.UNIT</td>
                                    <td>@detail.PRICE.ToStringVN() @detail.CURRENCY</td>
                                    <td>@detail.SUM_VALUE.ToStringVN() @detail.CURRENCY</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ Html.RenderPartial("Paging", Model); }

<script type="text/javascript">
    $(function () {
        Forms.CompleteUI();
    });
</script>
