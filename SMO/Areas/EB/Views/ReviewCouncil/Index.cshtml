@model SMO.Service.EB.ReviewCouncilService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewCouncil_Index";

}
<div id='@Model.ViewId'>
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken();
        @Html.HiddenFor(m => m.ObjDetail.REVIEW_ID)
        @Html.HiddenFor(m => m.ViewId)
        <input type="hidden" id="isUpdate" name="isUpdate" value="0" />

        <div class="card border-grey">
            @if (ProfileUtilities.User.IS_CHANGE_LANG)
            {
                <div class="divLanguage">
                    <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                </div>
            }
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active"><a style="padding-left:0px"><i class="material-icons col-fecon">people</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a></li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdAdd", LanguageUtilities.LangText("cmdAdd", frmCode), "AddCouncil();", "Alt+S", "add")
                            @Html.MyButton("cmdRemove", LanguageUtilities.LangText("cmdRemove", frmCode), "RemoveCouncilOfReview();", "Alt+S", "delete")
                            @*@Html.MyButton("cmdUpdate", LanguageUtilities.LangText("cmdUpdate", frmCode), "SubmitListCouncilOfReview('1');", "Alt+S", "done_all")*@
                            @Html.MyButton("cmdSendMail", LanguageUtilities.LangText("cmdSendMail", frmCode), "SendMailCouncilOfReview2();", "", "email")
                        </div>
                    </div>

                    <div id="divResult">
                    </div>
                </div>
            </div>
        </div>
    }


    <script type="text/javascript">
        function AddCouncil() {
            var reviewId = '@Model.ObjDetail.REVIEW_ID';
            var params = {
                url : "@Url.Action("AddCouncil")",
                data: { reviewId: reviewId }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function RemoveCouncilOfReview() {
            if (!confirm("Bạn có chắc chắn xóa không?")) {
                return;
            }
            var lstSelected = '';
            $('#@Model.ViewId .chkItemCouncilOfReview').each(function () {
                if (this.checked) {
                    lstSelected += $(this).attr('modelId') + ',';
                }
            });
            if (lstSelected == '') {
                alert("Bạn hãy chọn ít nhất một người dùng!");
                return;
            }

            lstSelected = lstSelected.substring(0, lstSelected.length - 1);
            var ajaxParams = {
                url: "@Url.Action("DeleteCouncilOfReview")",
                type: 'POST',
                dataType : 'json',
                data: { lstCouncil: lstSelected, reviewId: '@Model.ObjDetail.REVIEW_ID'}
            };
            Forms.Ajax(ajaxParams);
    }

        function SendMailCouncilOfReview2() {
            var lstSelected = '';
            $('#@Model.ViewId .chkItemCouncilOfReview').each(function () {
                if (this.checked) {
                    lstSelected += $(this).attr('modelId') + ',';
                }
            });
            if (lstSelected == '') {
                alert("Bạn hãy chọn ít nhất một người dùng!");
                return;
            }

            lstSelected = lstSelected.substring(0, lstSelected.length - 1);
            var ajaxParams = {
                url: "@Url.Action("SendMailCouncilOfReview2")",
                type: 'POST',
                dataType : 'json',
                data: { id: @Model.ObjDetail.REVIEW_ID, lstSelected: lstSelected}
            };
            Forms.Ajax(ajaxParams);
        }

        function SubmitListCouncilOfReview(isUpdate) {
            $("#@Model.ViewId #isUpdate").val(isUpdate);
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.CompleteUI();
        });
    </script>
</div>
