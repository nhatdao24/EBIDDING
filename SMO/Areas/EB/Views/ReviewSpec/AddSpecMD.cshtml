@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var reviewId = ViewBag.ReviewId;
    var frmCode = "frm_EbReviewSpec_AddSpecMD";

}
<div class="modal-close">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>
<div class="modal-body">
    <div id='@Model.ViewId' class="content">
        <input type="hidden" name="reviewId" value="@reviewId" />

        <div class="card">
            @if (ProfileUtilities.User.IS_CHANGE_LANG)
            {
                <div class="divLanguage">
                    <i class="col-fecon material-icons" onclick="MaintainLanguageForm('@frmCode')" title="Chỉnh sửa ngôn ngữ">public</i>
                </div>
            }
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20" @*style="float:left"*@>
                            @Html.MyButton("cmdSelect", @LanguageUtilities.LangText("cmdSelect", frmCode), "AddSpecMDToReview();", "", "add")
                        </div>
                        @*<div class="input-group page-function-search">
                                <div class="form-line">
                                    <input type="text" name="name" value="" class="form-control align-center" placeholder = "@LanguageUtilities.LangText("lblPlaceHolder", frmCode)"/>
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                            </div>*@
                    </div>

                    <div id="divResult" style="overflow-x: auto;">
                        <ul id="treeSpecMD" class="ztree"></ul>
                    </div>
                </div>
            </div>
        </div>


        <script type="text/javascript">
            var zNodesSpecMD = jQuery.parseJSON('@Html.Raw(ViewBag.zNodeSpec)');


            function AddSpecMDToReview() {
                var zTree = $.fn.zTree.getZTreeObj("treeSpecMD");
                var nodeChange = zTree.getChangeCheckedNodes(true);
                var arrSpec = [];
                $.each(nodeChange, function (i, val) {
                    arrSpec.push(nodeChange[i].id);
                    nodeChange[i].nocheck = true;
                    zTree.updateNode(nodeChange[i]);
                });

                if (arrSpec.length == 0) {
                    alert("Bạn hãy chọn ít nhất một tiêu chí!");
                    return;
                }

                var ajaxParams = {
                    url: "@Url.Action("AddSpecMDToReview")",
                    type: 'POST',
                    dataType : 'json',
                    data: { lstSpec: arrSpec.join("|"), reviewId: '@reviewId' }
                };
                Forms.Ajax(ajaxParams);
            }

            $(function () {
                Forms.CompleteUI();
                $.fn.zTree.init($("#treeSpecMD"), settingSpecMD, zNodesSpecMD);
            });
        </script>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-link waves-effect" data-dismiss="modal">✖</button>
</div>

