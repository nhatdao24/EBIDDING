@model SMO.Service.EB.ReviewFinalService
@using SMO.Repository.Common
@using SMO.Repository.Implement.EB
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewFinal_Detail";
    JsonSerializerSettings serializerSetting = new JsonSerializerSettings() { ReferenceLoopHandling = ReferenceLoopHandling.Ignore };
    IUnitOfWork UnitOfWork = new NHUnitOfWork();
    var lstRating = Model.ObjListRating.Select(x => x.RATING).Distinct().ToList();
    var randomNumber = new Random().Next(1, 1000);
    var fromDate = Model.ObjDetail.FROM_DATE.Value.ToString("dd/MM/yyyy HH:mm");
    var toDate = Model.ObjDetail.TO_DATE.Value.ToString("dd/MM/yyyy HH:mm");

    //Kiểm tra user cần phê duyệt hay không
    var checkApprove = false;
    if (Model.ObjDetail.STATUS == Review_Final_Status.ChoPheDuyet || Model.ObjDetail.STATUS == Review_Final_Status.DangPheDuyet)
    {
        var userApprove = Model.ObjDetail.ListUser.FirstOrDefault(x => x.USER_NAME == ProfileUtilities.User.USER_NAME && x.IS_APPROVED == false);
        if (userApprove == null)
        {
            checkApprove = false;
        }
        else
        {
            // Kiểm tra user level thấp hơn đã phê duyệt hay chưa
            if (Model.ObjDetail.ListUser.FirstOrDefault(x => x.C_LEVEL < userApprove.C_LEVEL && x.IS_APPROVED == false) != null)
            {
                checkApprove = false;
            }
            else
            {
                checkApprove = true;
            }
        }

    }

    //Check user có đc hủy phê duyệt hay ko
    var checkApprove2 = false;
    if (Model.ObjDetail.STATUS == Review_Final_Status.DaPheDuyet || Model.ObjDetail.STATUS == Review_Final_Status.DangPheDuyet)
    {
        var userApprove = Model.ObjDetail.ListUser.FirstOrDefault(x => x.USER_NAME == ProfileUtilities.User.USER_NAME && x.IS_APPROVED == true);
        if (userApprove == null)
        {
            checkApprove2 = false;
        }
        else
        {
            // Kiểm tra user level cao hơn đã phê duyệt hay chưa
            if (Model.ObjDetail.ListUser.FirstOrDefault(x => x.C_LEVEL > userApprove.C_LEVEL && x.IS_APPROVED == false) != null)
            {
                checkApprove2 = false;
            }
            else
            {
                checkApprove2 = true;
            }
        }
    }
}
