                <label for="chk__USER_NAME" style="font-size: 14px;">&nbsp;&nbsp;_USER_NAME</label>
            </td>
            <td>
                <input type="number" name="ObjDetail.ListUser[_Index].C_LEVEL" class="form-control" value="_C_LEVEL" />
            </td>
            <td style="vertical-align:middle;">
                <input type="hidden" id="hddIsDelete__Index" name="ObjDetail.ListUser[_Index].IS_DELETE" class="form-control" value="" />
                <i class="material-icons col-red" onclick="RemoveUser(this, '_Index','_USER_NAME');" style="cursor:pointer">remove_circle_outline</i>
            </td>
        </tr>
    </script>

    <script type="text/javascript">
        var numberCurrent = @(Model.ObjDetail.ListUser.Count());
        var lstUser = @Html.Raw(JsonConvert.SerializeObject(Model.ObjDetail.ListUser, serializerSetting));
        var ListRating = @Html.Raw(JsonConvert.SerializeObject(Model.ObjListRating, serializerSetting));
        function CloseFormEdit(){
            Forms.Close('@Model.ViewId');
        }

        function ShowDialogUser(){
            var params = {
                url : "@Url.Action("AddUser")"
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function SubmitForm() {
            debugger;
            var FromDate = $('#fromDate').val();
            var ToDate = $('#toDate').val();
            if (new Date(FromDate) > new Date(ToDate)) {
                Message.func.AlertDanger({ Message: { Code: "", Message: "(Từ ngày) phải nhỏ hơn hoặc bằng (Đến ngày) !" } });
                return;
            }
            if (FromDate != '@fromDate' || ToDate != '@toDate') {
                if (!confirm("Thông tin khoảng ngày đã bị thay đổi, dữ liệu sẽ bị xóa hết. Bạn có chắc chắn ko?")) {
                    return;
                }
            }

            var formData = new FormData($('#@Model.FormId')[0]);
            Forms.ShowLoading();

            var headers = {
                'RequestVerificationToken': $('#antiForgeryToken').val(),
            };
            $.ajax({
                xhr: function () {
                    var xhr = new window.XMLHttpRequest();

                    xhr.upload.addEventListener("progress", function (evt) {
                        if (evt.lengthComputable) {
                            var percentComplete = evt.loaded / evt.total;
                            percentComplete = parseInt(percentComplete * 100);
                            console.log(percentComplete);

                            if (percentComplete === 100) {
                                //alert("kakalot");
                            }
                        }
                    }, false);

                    return xhr;
                },
                type: "POST",
                url: "@Url.Action("Update")",
                data: formData,
                headers: headers,
                contentType: false,
                processData: false,
                success: function (response) {
                    Message.execute(response);
                    if (response.State == true) {
                        try {
                            SubmitIndex();
                        } catch (e) {

                        }
                        Forms.LoadAjax('@Url.Action("Detail", new { id = Model.ObjDetail.CODE})');
                        Forms.Close('@ViewBag.ViewIdDetail');
                        Forms.Close('@Model.ViewId');
                        Forms.AjaxLoadSuccessHandler(response);
                    }
                    Forms.HideLoading();
                },
                error: Forms.AjaxErrorHandler
            });
        }

        function DeleteContractor(contractorId, reviewId) {
            if (confirm("Bạn có chắc chắn xóa nhà thầu này?")) {
                var ajaxParams = {
                    url: "@Url.Action("DeleteContractor")",
                    type: "POST",
                    data: { contractorId: contractorId, reviewId: reviewId, viewId: "@Model.ViewId" },
                    dataType: "json",
                    success: function (response) {
                        Message.execute(response);
                    }
                };
                Forms.Ajax(ajaxParams);
            }
        }

        function ShowDialogContractor(){
            var reviewId = '@Model.ObjDetail.CODE';
            var params = {
                url: "@Url.Action("AddContractor")",
                data: { reviewId: reviewId }
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function AddUser(userName, c_level) {
            debugger;
            var html = $('#RowUserTemplate').html();
            html = html.replace(/_USER_NAME/g, userName);
            html = html.replace(/_C_LEVEL/g, c_level);
            html = html.replace(/_Index/g, numberCurrent);
            $("#body_user_approve").append(html);
            numberCurrent++;
        }

        function RemoveUser(obj, index, userName) {
            debugger;
            $("#user_" + index).hide();
            $("#hddIsDelete_" + index).val("1");
            //lstUser.splice(index, 1);
            lstUser = $.grep(lstUser, function (e) { return e.USER_NAME != userName });
        }

        function OnChangeUser() {
            debugger;
            var arr = [];
            var html_level = "";
            var old_html = $('#user_approve').find('.hddUser');
            if (old_html.length > 0) {
                $('.hddUser').each(function () {
                    var user_name = $(this).val();
                    var level = $(".user_" + user_name).val();
                    var pkid = $("#pkid_" + user_name).val();
                    var reviewId = $("#reviewId_" + user_name).val();
                    var isApprove = $("#isApprove_" + user_name).val();
                    arr.push({ user: user_name, user_level: level, pkId: pkid, review_id: reviewId, is_approve: isApprove });
                });
            }
            $('#user_approve').html("");
            var html = "";
            $('#dllUserApprove option:selected').each(function (index) {
                var value = $(this).val();
                var text = $(this).text();
                html += '<tr>';
                html += '<td>';
                html += '<input type="hidden" class="hddUser" name="ObjDetail.ListUser[' + index + '].USER_NAME" value="' + value + '" id="chk_' + value + '" order="' + index + '" />';
                html += '<label for= "chk_' + value + '" style = "font-size: 14px;" >&nbsp;&nbsp;' + text + '</label>';
                html += '</td>';
                html += '<td>';
                var myInfo = arr.find(function (current_user) {
                    return current_user.user == value;
                });
                if (arr.length > 0 && myInfo != null) {
                    if (myInfo.pkId == null) {
                        myInfo.pkId = '';
                    }
                    html += '<input type="hidden" name="ObjDetail.ListUser[' + index + '].PKID" class="form-control" id="pkid_' + value + '" value="' + myInfo.pkId + '" />';
                    html += '<input type="hidden" name="ObjDetail.ListUser[' + index + '].REVIEW_ID" class="form-control" id="reviewId_' + value + '" value="' + myInfo.review_id + '" />';
                    html += '<input type="hidden" name="ObjDetail.ListUser[' + index + '].IS_APPROVED" class="form-control" id="isApprove_' + value + '" value="' + myInfo.is_approve + '" />';
                    html += '<input type="number" name="ObjDetail.ListUser[' + index + '].C_LEVEL" class="form-control user_' + value + '" id="txtLevel_' + index + '" value="' + myInfo.user_level + '" />';
                } else {
                    html += '<input type="number" name="ObjDetail.ListUser[' + index + '].C_LEVEL" class="form-control user_' + value + '" id="txtLevel_' + index + '" value="1" />';
                }

                html += '</td>';
                html += '</tr>';
            });
            $('#user_approve').append(html);
        }

        function OnChangeScore(obj, index) {
            debugger;
            var score = $(obj).val();
            var rating = "";
            $.each(ListRating, function () {
                if (this.FROM_VALUE <= score && score <= this.TO_VALUE) {
                    rating = this.RATING;
                }
            });
            $('#@Model.ViewId #rate_' + index).val(rating);
            Forms.CompleteUI();
        }

        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>


