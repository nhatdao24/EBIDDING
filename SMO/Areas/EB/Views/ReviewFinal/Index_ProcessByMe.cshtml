@model SMO.Service.EB.ReviewFinalService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewFinal_Index";

}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FormId)
        @Html.HiddenFor(m => m.ObjDetail.STATUS, new { id = "hddStatus" })
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist" id="ulReviewIndex">
                    <li role="presentation" class="active" style="cursor: pointer;" onclick="$('#hddStatus').val('01'); OnClickTab(this)">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">playlist_play</i> @LanguageUtilities.LangText("lblTitle1", frmCode)</a>
                    </li>
                    <li role="presentation" style="cursor: pointer;" onclick="$('#hddStatus').val('02'); OnClickTab(this)">
                        <a><i class="material-icons col-fecon">playlist_add_check</i> @LanguageUtilities.LangText("lblTitle2", frmCode)</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        @*<div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdAdd", @LanguageUtilities.LangText("cmdAdd", frmCode), string.Format("Forms.LoadAjax('{0}');", @Url.Action("Create")), "Alt+N", "add")
                            </div>*@
                        <div class="input-group page-function-search">
                            <div class="form-line">
                                @Html.MyTextBoxFor(m => m.ObjDetail.DESCRIPTION, new { placeholder = LanguageUtilities.LangText("lblSearch", frmCode), @class = "align-center", @data_val = false })
                            </div>

                            <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                <i class="material-icons">search</i>
                            </span>
                            <span class="input-group-addon" title="Tìm theo các chỉ tiêu khác" id="spShowMore" onclick="$('#spHideMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                <i class="material-icons">expand_more</i>
                            </span>
                            <span class="input-group-addon" title="Ẩn các chỉ tiêu tìm kiếm khác" style="display:none;" id="spHideMore" onclick="$('#spShowMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                <i class="material-icons">expand_less</i>
                            </span>
                            <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                <i class="material-icons">refresh</i>
                            </span>
                        </div>
                    </div>
                    <div class="page-search-advance row m-l-0 m-r-0 m-b-10" style="display:none;">
                        <div class="col-md-4 col-xs-12 input-daterange">
                            <label>@LanguageUtilities.LangText("lblNgayTao", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.FROM_DATE, new { @data_val = false, @placeholder = LanguageUtilities.LangText("lblFrom", frmCode) })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.TO_DATE, new { @data_val = false, @placeholder = LanguageUtilities.LangText("lblTo", frmCode) })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="divResult">

                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/javascript">
        function SubmitIndex() {
            Forms.SubmitForm('@Model.FormId');
        }

        function OnClickTab(tab) {
            $("#ulReviewIndex li").removeClass("active");
            $(tab).addClass("active");
            SubmitIndex();
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");

            $('.input-daterange').datepicker({
                format: "dd/mm/yyyy",
                maxViewMode: 2,
                autoclose: true,
                keyboardNavigation: false,
                todayBtn: "linked",
                clearBtn: true,
                todayHighlight: true,
                language: "vi"
            });
        });
    </script>
</div>




