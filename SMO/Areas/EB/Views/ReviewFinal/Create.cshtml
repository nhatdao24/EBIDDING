@model SMO.Service.EB.ReviewFinalService
@using Newtonsoft.Json
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_ReviewFinal_Create";
    JsonSerializerSettings serializerSetting = new JsonSerializerSettings() { ReferenceLoopHandling = ReferenceLoopHandling.Ignore };
}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("Create", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.ViewId)
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> @LanguageUtilities.LangText("lblTitle", frmCode)</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdBack", LanguageUtilities.LangText("cmdBack", frmCode), string.Format("Forms.Close('{0}');", @Model.ViewId), "", "arrow_back")
                            @Html.MyButton("cmdSave", LanguageUtilities.LangText("cmdSave", frmCode), string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                        </div>
                    </div>

                    <div class="row m-t-20">
                        <div class="col-xs-12">
                            <label>@LanguageUtilities.LangText("lblMoTa", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.DESCRIPTION)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.DESCRIPTION)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblTuNgay", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.FROM_DATE, new { @class = "datetimepicker", @data_val = false })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.FROM_DATE)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblDenNgay", frmCode)</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.TO_DATE, new { @class = "datetimepicker", @data_val = false })
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.TO_DATE)
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6">
                            <label>@LanguageUtilities.LangText("lblChonNguoiPheDuyet", frmCode)</label>
                            <div class="m-b-10">
                                <span class="waves-effect btn-outline-primary btn" onclick="ShowDialogUser();">
                                    <span>@LanguageUtilities.LangText("cmdAddUser", frmCode)</span>
                                </span>
                            </div>

                            <div class="row m-t-20">
                                <div class="col-xs-12">
                                    <table class="table font-13">
                                        <thead>
                                            <tr>
                                                <th class="align-center">@LanguageUtilities.LangText("lblNguoiPheDuyet", frmCode)</th>
                                                <th class="align-center">@LanguageUtilities.LangText("lblThuTuPheDuyet", frmCode)</th>
                                                <th class="align-center">#</th>
                                            </tr>
                                        </thead>
                                        <tbody id="body_user_approve">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/html" id="RowUserTemplate">
        <tr id="user__Index">
            <td class="align-center">
                <input type="hidden" readonly name="ObjDetail.ListUser[_Index].USER_NAME" class="hddUser form-control" value="_USER_NAME" />
                <label for="chk__USER_NAME" style="font-size: 14px;">&nbsp;&nbsp;_USER_NAME</label>
            </td>
            <td class="align-center">
                <input type="number" name="ObjDetail.ListUser[_Index].C_LEVEL" class="form-control" value="_C_LEVEL" />
            </td>
            <td style="vertical-align:middle;" class="align-center">
                <input type="hidden" id="hddIsDelete__Index" name="ObjDetail.ListUser[_Index].IS_DELETE" class="form-control" value="" />
                <i class="material-icons col-red" onclick="RemoveUser(this, '_Index','_USER_NAME');" style="cursor:pointer">remove_circle_outline</i>
            </td>
        </tr>
    </script>

    <script type="text/javascript">
        var numberCurrent = @(Model.ObjDetail.ListUser.Count());
        var lstUser = @Html.Raw(JsonConvert.SerializeObject(Model.ObjDetail.ListUser, serializerSetting));
        function CloseFormCreate(){
            Forms.Close('@Model.ViewId');
        }

        function ShowDialogUser(){
            var params = {
                url : "@Url.Action("AddUser")"
            };
            Forms.ShowLoading();
            Forms.LoadAjaxModal(params);
        }

        function AddUser(userName, c_level) {
            debugger;
            var html = $('#RowUserTemplate').html();
            html = html.replace(/_USER_NAME/g, userName);
            html = html.replace(/_C_LEVEL/g, c_level);
            html = html.replace(/_Index/g, numberCurrent);
            $("#body_user_approve").append(html);

            lstUser.push(
                { USER_NAME: userName, C_LEVEL: c_level }
            );

            numberCurrent++;
        }

        function RemoveUser(obj, index, userName) {
            debugger;
            $("#user_" + index).hide();
            $("#hddIsDelete_" + index).val("1");
            //lstUser.splice(index, 1);
            lstUser = $.grep(lstUser, function (e) { return e.USER_NAME != userName });
        }

        function OnChangeUser() {
            debugger;
            var arr = [];
            var html_level = "";
            var old_html = $('#user_approve').find('.hddUser');
            if (old_html.length > 0) {
                $('.hddUser').each(function () {
                    var user_name = $(this).val();
                    var level = $(".user_" + user_name).val();
                    arr.push({ user: user_name, user_level: level });
                });
            }
            $('#user_approve').html("");
            var html = "";
            $('#dllUserApprove option:selected').each(function (index) {
                var value = $(this).val();
                var text = $(this).text();
                html += '<tr>';
                html += '<td>';
                html += '<input type="hidden" class="hddUser" name="ObjDetail.ListUser[' + index + '].USER_NAME" value="' + value + '" id="chk_' + value + '" order="' + index + '" />';
                html += '<label for= "chk_' + value + '" style = "font-size: 14px;" >&nbsp;&nbsp;' + text + '</label>';
                html += '</td>';
                html += '<td>';
                var myInfo = arr.find(function (current_user) {
                    return current_user.user == value;
                });
                if (arr.length > 0 && myInfo != null) {
                    html += '<input type="number" name="ObjDetail.ListUser[' + index + '].C_LEVEL" class="form-control user_' + value + '" id="txtLevel_' + index + '" value="' + myInfo.user_level + '" />';
                } else {
                    html += '<input type="number" name="ObjDetail.ListUser[' + index + '].C_LEVEL" class="form-control user_' + value + '" id="txtLevel_' + index + '" value="1" />';
                }

                html += '</td>';
                html += '</tr>';
            });
            $('#user_approve').append(html);
        }
        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>

