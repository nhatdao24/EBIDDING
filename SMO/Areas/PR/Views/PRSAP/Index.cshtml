@model SMO.Service.PR.PRSAPService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmCode = "frm_PRSAP_Index";

}
<div id='@Model.ViewId'>
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId, "#divResultPRSAP"), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.FormId)
        <div class="page-function">
            <div class="page-function-button m-r-20" style="float:left">
                @Html.MyButton("cmdSyn", LanguageUtilities.LangText("cmdSyn", frmCode), string.Format("Forms.SynchronizeMD('{0}');", Url.Action("Synchronize")), "Đồng bộ danh mục từ SAP", "sync")
            </div>
            <div class="input-group page-function-search">
                <div class="form-line">
                    @Html.MyTextBoxFor(m => m.ObjDetail.CODE, new { placeholder = LanguageUtilities.LangText("lblPlaceholder", frmCode), @class = "align-center", @data_val = false })
                </div>
                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                    <i class="material-icons">search</i>
                </span>
                <span class="input-group-addon" title="Tìm theo các chỉ tiêu khác" id="spShowMoreSAP" onclick="$('#spHideMoreSAP').toggle(); $(this).toggle(); $('.page-search-advanceSAP').toggle();">
                    <i class="material-icons">expand_more</i>
                </span>
                <span class="input-group-addon" title="Ẩn các chỉ tiêu tìm kiếm khác" style="display:none;" id="spHideMoreSAP" onclick="$('#spShowMoreSAP').toggle(); $(this).toggle(); $('.page-search-advanceSAP').toggle();">
                    <i class="material-icons">expand_less</i>
                </span>
                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                    <i class="material-icons">refresh</i>
                </span>
            </div>
        </div>
        <div class="page-search-advanceSAP row m-l-0 m-r-0 m-b-10" style="display:none;">
            <div class="col-md-4 col-xs-12">
                <label>@LanguageUtilities.LangText("lblNgayYeuCau", frmCode)</label>
                <div class="input-group form-group">
                    <div class="form-line">
                        @Html.MyTextBoxFor(m => m.ObjDetail.REQUIRE_DATE, new { @class = "datepicker", @data_val = false })
                    </div>
                    <span class="input-group-addon">
                        <i class="material-icons">date_range</i>
                    </span>
                </div>
            </div>
        </div>
        <div id="divResultPRSAP">

        </div>
    }
    <script type="text/javascript">
        function SubmitIndexPRSAP() {
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");
        });
    </script>
</div>


