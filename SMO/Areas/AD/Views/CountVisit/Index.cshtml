@model SMO.Service.AD.CountVisitService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmFormCode = "frmCountVisitIndex";
}
<div id='@Model.ViewId' class="container-fluid child-content">
    <div class="card border-grey">
        <div class="body" style="padding-top: 0px;">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a style="padding-left:0px" href="#tabCountVisit" data-toggle="tab"><i class="material-icons col-fecon">clear_all</i>LƯỢT TRUY CẬP</a>
                </li>
            </ul>

            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="tabCountVisit">
                 
                    @using (Ajax.BeginForm("Statistical", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.FormId)
                        <div class="page-function">
                            <div class="page-function-button m-r-20" style="float:left">
                                @Html.MyButton("cmdAdd", "Xem chi tiết", string.Format("Forms.LoadAjax('{0}');", @Url.Action("DetailCountVisit")), "Alt+N", "add")
                            </div>
                            <div id="divResult">

                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        function SubmitIndex() {
            Forms.SubmitForm('@Model.FormId');
        }
        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");
        });
    </script>
</div>