@model SMO.Service.AD.CountVisitService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var frmFormCode = "frmCountVisitIndex";
}
<div id='@Model.ViewId' class="container-fluid child-content">
    <div class="card border-grey">
        <div class="body" style="padding-top: 0px;">
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active">
                    <a style="padding-left:0px" href="#tabCountVisit" data-toggle="tab"><i class="material-icons col-fecon">clear_all</i>LƯỢT TRUY CẬP</a>
                </li>
            </ul>

            <div class="tab-content">
                <div role="tabpanel" class="tab-pane fade in active" id="tabCountVisit">

                    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
                    {
                                @Html.MyButton("cmdBack", "Quay lại", string.Format("Forms.Close('{0}');", @Model.ViewId), "Alt+N", "arrow_back")
                        <hr />
                       
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.FormId)<div class="page-function">
                            <div class="input-group page-function-search" style="margin-bottom: 7px !important">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.ACCESS_TYPE, new { placeholder = "Tìm kiếm theo loại trình duyệt", @class = "align-center", @data_val = false })
                                </div>
                                <span class="input-group-addon" title="Tìm kiếm" onclick="Forms.SubmitForm('@Model.FormId')">
                                    <i class="material-icons">search</i>
                                </span>
                                <span class="input-group-addon" title="Tìm theo các chỉ tiêu khác" id="spShowMore" onclick="$('#spHideMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                    <i class="material-icons">expand_more</i>
                                </span>
                                <span class="input-group-addon" title="Ẩn các chỉ tiêu tìm kiếm khác" style="display:none;" id="spHideMore" onclick="$('#spShowMore').toggle(); $(this).toggle(); $('.page-search-advance').toggle();">
                                    <i class="material-icons">expand_less</i>
                                </span>
                                <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="Forms.ResetForm('@Model.FormId')">
                                    <i class="material-icons">refresh</i>
                                </span>
                            </div>

                        </div>
                        <div class="page-search-advance row m-l-0 m-r-0 m-b-10" style="display:none;">
                            <div class="col-md-4 col-xs-12">
                                <label>Lượt truy cập theo ngày</label>
                                <div class="input-group form-group">
                                    <div class="form-line">
                                        @Html.MyTextBoxFor(m => m.ObjDetail.CREATE_DATE, new { @class = "datepicker", @data_val = false })
                                    </div>
                                    <span class="input-group-addon">
                                        <i class="material-icons">date_range</i>
                                    </span>
                                </div>
                            </div>

                            <div class="col-md-4 col-xs-12">
                                <label>Loại lượt truy cập</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.VIEW_TYPE,
                                        new SelectList(new List<SelectListItem>
                                        {
                                             new SelectListItem { Value = "", Text = "-" },
                                            new SelectListItem { Value = "AD", Text = "Màn hình quản trị" },
                                            new SelectListItem { Value = "PK", Text = "Màn hình gói thầu" }
                                        }, "Value", "Text"),
                                        new { @class = "selectpicker show-tick", @data_container = "body" })
                                </div>
                            </div>

                            <div class="col-md-4 col-xs-12">
                                <label>Người truy cập CTD hoặc Nhà thầu</label>
                                <div class="form-group">
                                    @Html.MyDropDownListFor(m => m.ObjDetail.CREATE_BY, SelectListUtilities.GetAllUserFecon(true), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                                </div>
                            </div>

                            <div class="clearfix"></div>

                        </div>
                        <div id="divResult">

                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        function SubmitIndex() {
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            Forms.SubmitForm('@Model.FormId');
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");
        });
    </script>
</div>