@model SMO.Service.AD.UserService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}
<div id='@Model.ViewId' class="container-fluid child-content">
    <link href="~/Content/zTreeStyle/zTreeStyle.css" rel="stylesheet" />
    <script src="~/Scripts/Ztree/jquery.ztree.core-3.5.min.js"></script>
    <script src="~/Scripts/Ztree/jquery.ztree.excheck-3.5.min.js"></script>
    @using (Ajax.BeginForm("List", null, FormDataUtils.GetAjaxOptions(Model.ViewId, "#divResultUserOrg"), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FormId)
        @Html.HiddenFor(m => m.ObjDetail.USER_TYPE)
        @Html.HiddenFor(m => m.ObjDetail.ORGANIZE_ID, new { @id = "ddlOrgIndex" })
        @*if (ViewBag.CountOrg == 1)
            {
                @Html.HiddenFor(m => m.ObjDetail.COMPANY_CODE)
            }*@
        <div class="card">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons">clear_all</i> DANH SÁCH NGƯỜI DÙNG COTECCONS </a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function p-b-10">
                        <div class="page-function-button m-r-20" style="float:left">
                            @Html.MyButton("cmdAdd", "Thêm mới", "CreateUser();", "Alt+N", "person_add")
                            @*@Html.MyButton("cmdDelete", "Xóa", string.Format("Forms.DeleteItems('{0}','chkItem');", @Url.Action("Delete")), "Alt+D", "delete")*@
                        </div>
                        <div class="input-group page-function-search">
                            <div class="form-line">
                                @Html.MyTextBoxFor(m => m.ObjDetail.USER_NAME, new { placeholder = "Tìm theo tên đăng nhập hoặc họ tên", @class = "align-center", @data_val = false })
                            </div>

                            <span class="input-group-addon" title="Tìm kiếm" onclick="SubmitIndex();">
                                <i class="material-icons">search</i>
                            </span>
                            <span class="input-group-addon" title="Làm mới ô tìm kiếm" onclick="ResetFormSearch();">
                                <i class="material-icons">refresh</i>
                            </span>
                        </div>
                    </div>
                    @*<div class="page-search-advance row m-l-0 m-r-0 m-b-10" style="display:none;">
                            <div class="col-md-4 col-xs-12">
                                <label>Kiểu người dùng</label>
                                <div class="form-group">
                                    <select name="@Html.NameFor(m => m.ObjDetail.USER_TYPE)" id="dllUserTypeIndex"
                                            data-live-search="true" data-show-subtext="true"
                                            class="selectpicker show-tick dropdown form-control">
                                        <option value="">-</option>
                                        <option value="@UserType.SaleManager">@UserType.GetText(UserType.SaleManager)</option>
                                        <option value="@UserType.SaleOffice">@UserType.GetText(UserType.SaleOffice)</option>
                                        <option value="@UserType.Admin">@UserType.GetText(UserType.Admin)</option>
                                    </select>
                                </div>
                            </div>
                        </div>*@
                    @if (ViewBag.CountOrg == 1)
                    {
                        <div id="divResultUserOrg">

                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <div class="col-sm-4">
                                @*@Html.MyDropDownListFor(m => m.ObjDetail.ORGANIZE_ID, SelectListUtilities.GetCompany(), new { @id = "ddlOrgIndex", @data_live_search = "true", @class = "selectpicker show-tick", placeholder = "Tìm theo mã hoặc tên đơn vị", @data_val = false, @OnChange = "OnChangeDllOrg();" })*@

                                <div id="divTreeOrg" class="border-grey" style="height: calc(100vh - 230px); overflow:auto; margin-top: 12px;">
                                    <input type="hidden" id="hddParent" value="" />
                                    <ul id="treeOrgInIndex" class="ztree"></ul>
                                </div>
                            </div>
                            <div class="col-sm-8">
                                <div id="divResultUserOrg">

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    }

    <script type="text/javascript">
        function CreateUser() {
            var organizeId = document.getElementById("ddlOrgIndex").value;

            if (organizeId === null || organizeId === '') {
                Message.func.AlertDanger({ Message: { Code: "", Message: "Bạn phải chọn phòng ban trước khi tạo người dùng mới !" } });
                return;
            }

            var param = {
                url: '@Url.Action("CreateUserOrganzie")',
                data: { parent: $("#ddlOrgIndex").val()}
            }
            Forms.LoadAjaxRight(param);
        }

        function OnChangeDllOrg() {
            SubmitIndex();
            SearchOrg();
        }

        function SearchOrg() {
            try {
                var value = $("#ddlOrgIndex").val();
                var zTree = $.fn.zTree.getZTreeObj("treeOrgInIndex");
                zTree.cancelSelectedNode();
                var node = zTree.getNodeByParam("id", value, null);
                if (node != null) {
                    zTree.selectNode(node);
                }
            } catch (e) {

            }
        }

        function ResetFormSearch() {
            Forms.ResetForm('@Model.FormId');
            var zTree = $.fn.zTree.getZTreeObj("treeOrgInIndex");
            zTree.cancelSelectedNode();
            $("#ddlOrgIndex").val('');
        }

        var settingOrganize = {
            view: {
                selectedMulti: false,
                nameIsHTML: true,
                showTitle: false
            },
            edit: {
                enable: false,
                showRemoveBtn: false,
                showRenameBtn: false
            },
            data: {
                simpleData: {
                    enable: true
                }
            },
            callback: {
                onClick: OnClickOrganize
            }
        };

        function OnClickOrganize(event, treeId, treeNode) {
            debugger;
            var id = treeNode.id;
            $("#ddlOrgIndex").val(id);
            SubmitIndex();
        };

        function ShowHistory(userName) {
            var params = {
                url: '/AD/UserHistory',
                data: { userName: userName }
            };
            Forms.LoadAjaxModalLarge(params);
    }

        @*function OnChangeUserType() {
            $("#divCuaHang").hide();
            var value = $("#dllUserType").val();
            if (value == '@UserType.SaleOffice') {
                $("#divCuaHang").show();
            }

            $("#liKhachHang").hide();
            if (value == "@UserType.SaleManager") {
                $("#liKhachHang").show();
            }
        }*@

        function OnChangeCompany() {
            var companyCode = $("#dllCompany").find(':selected').data("company");
            $("#dllSaleOffice").val("");
            $("#dllSaleOffice option").removeAttr('disabled');;
            $("#dllSaleOffice option").each(function () {
                if ($(this).data('company') != companyCode) {
                    $(this).attr('disabled', 'disabled');
                }
            });

            $("#dllSaleOffice").selectpicker('refresh');
        }

        function SubmitIndex() {
            Forms.SubmitForm('@Model.FormId');
        }

        $(function () {
            SubmitIndex();
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");
            var zNodes = jQuery.parseJSON('@Html.Raw(ViewBag.zNodeOrg)');
            $.fn.zTree.init($("#treeOrgInIndex"), settingOrganize, zNodes);
            SearchOrg();
        });
    </script>
</div>


