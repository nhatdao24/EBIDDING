@model SMO.Service.AD.LanguageService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}
<div id='@Model.ViewId'>
    @using (Ajax.BeginForm("Create", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <span class="page-header-icon" onclick="Forms.CloseRightContent();" style="float:right;">
                    <i class="material-icons">arrow_forward</i>
                </span>
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">add</i> TẠO MỚI NGÔN NGỮ</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdSave", "Lưu lại", string.Format("Forms.SubmitForm('{0}');", @Model.FormId), "Alt+N", "done_all")
                        </div>
                    </div>

                    <div class="row m-t-20">
                        <div class="col-xs-12">
                            <label>Mã</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.FK_CODE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.FK_CODE)
                            </div>

                            <label>Kiểu</label>
                            <div class="form-group">
                                <select class="form-control selectpicker show-tick" name="@Html.NameFor(m => m.ObjDetail.OBJECT_TYPE)" required>
                                    <option value="T">T - TEXT</option>
                                    <option value="C">T - CONTROL</option>
                                    <option value="M">M - MENU</option>
                                </select>
                            </div>

                            <label>Ngôn ngữ</label>
                            <div class="form-group">
                                <select class="form-control selectpicker show-tick" name="@Html.NameFor(m => m.ObjDetail.LANG)" required>
                                    <option value="vi">vi - Tiếng Việt</option>
                                    <option value="en">en - Tiếng Anh</option>
                                </select>
                            </div>

                            <label>Form</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.FORM_CODE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.FORM_CODE)
                            </div>

                            <label>Nội dung</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.ObjDetail.VALUE)
                                </div>
                                @Html.ValidationMessageFor(m => m.ObjDetail.VALUE)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script type="text/javascript">
        $(function () {
            Forms.CompleteUI();
        });
    </script>
</div>


