
<div class="container-fluid child-content">
    <div class="row clearfix">
        <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
            <div class="m-b-20">
                <div class="card border-grey" id="divTopNotify">
                    @if (ProfileUtilities.User.IS_CHANGE_LANG)
                    {
                        <div class="divLanguage">
                            <i class="col-fecon material-icons" onclick="MaintainLanguageForm('frm_EB_TopNotify')" title="Chỉnh sửa ngôn ngữ">public</i>
                        </div>
                    }
                    <div class="header">
                        <span class="font-15 col-fecon">@LanguageUtilities.LangText("lblTitle", "frm_EB_TopNotify")</span>
                        <ul class="header-dropdown m-r--5">
                            <li class="dropdown">
                                <a href="#" role="button" title="Xem tất cả" onclick="$('#frmViewAllNotify').remove(); Forms.LoadAjax('/Notify')">
                                    <i class="material-icons">clear_all</i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="body dropdown-menu all-notify" id="divTopNotifyBody" style="box-shadow: none !important; height: 400px;">
                        <ul class="menu" data-bind="template: { name: 'RowTemplateNotify', foreach: ObjListNotify }"></ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4">
            <div class="card border-grey" id="divTopQuestion">
                <div class="header">
                    <span class="font-15 col-fecon">@LanguageUtilities.LangText("lblTitle", "frm_EB_TopQuestion")</span>
                    <ul class="header-dropdown m-r--5">
                        <li class="dropdown">
                            <a href="javascript:void(0);" role="button" title="Tải lại danh sách" onclick="$('#divTopQuestion .body').html(''); GetTopQuestion();">
                                <i class="material-icons">refresh</i>
                            </a>
                        </li>
                    </ul>
                </div>
                <div class="body" style="height: 400px;">
                </div>
            </div>
        </div>

        <div class="clearfix"></div>

        <div class="col-xs-12 col-sm-12">
            @if (AuthorizeUtilities.CheckUserRight("R501"))
            {
                <div class="m-b-20">
                    <div class="card border-grey" id="divTopRequest">
                        <div class="header">
                            <span class="font-15 col-fecon">@LanguageUtilities.LangText("lblTitle", "frm_EB_TopRequest")</span>
                            <ul class="header-dropdown m-r--5">
                                <li class="dropdown">
                                    <a href="javascript:void(0);" role="button" title="Tải lại danh sách" onclick="$('#divTopRequest .body').html(''); GetTopRequest();">
                                        <i class="material-icons">refresh</i>
                                    </a>
                                    <a href="#" role="button" title="Xem tất cả" onclick="Forms.LoadAjax('/EB/Request/Index');">
                                        <i class="material-icons">clear_all</i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="body">
                        </div>
                    </div>
                </div>
            }

            <div class="">
                <div class="card border-grey" id="divTopBid">
                    <div class="header">
                        <span class="font-15 col-fecon">@LanguageUtilities.LangText("lblTitle", "frm_EB_TopBid")</span>
                        <ul class="header-dropdown m-r--5">
                            <li class="dropdown">
                                <a href="javascript:void(0);" role="button" title="Tải lại danh sách" onclick="$('#divTopBid .body').html(''); GetTopBid();">
                                    <i class="material-icons">refresh</i>
                                </a>
                                <a href="#" role="button" title="Xem tất cả" onclick="Forms.LoadAjax('/EB/Bid/Index');">
                                    <i class="material-icons">clear_all</i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="body">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        GetTopBid();
        GetTopQuestion();
        @if (AuthorizeUtilities.CheckUserRight("R501"))
        {
            @: GetTopRequest();
        }
    });
</script>

