@model SMO.Service.EB.RequestService
@using SMO.Repository.Implement.EB
@{
    Layout = "~/Views/Shared/_Layout_Portal.cshtml";
}

@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
    var lang = "vi";
    if (Request.Cookies["lang"] != null)
    {
        lang = Request.Cookies["lang"].Value;
    }

    if (lang != "vi" && lang != "en")
    {
        lang = "vi";
    }

    var serviceScopeType = new SMO.Service.MD.ScopeTypeService();
    serviceScopeType.GetAll();
    var serviceScope = new SMO.Service.MD.ScopeService();
    serviceScope.GetAll();
    var serviceNumberOfProject = new SMO.Service.MD.NumberOfProjectService();
    serviceNumberOfProject.GetAll();
    var serviceOption = new SMO.Service.MD.OptionService();
    serviceOption.GetAll();
    var serviceBidType = new SMO.Service.MD.BidTypeService();
    serviceBidType.GetAll();
    var ListBidPublic = Model.UnitOfWork.Repository<BidRepo>().Queryable().Where(x => x.IS_PUBLIC == true && (x.GIAI_DOAN != Phase_Status.DongThau || x.GIAI_DOAN != Phase_Status.HuyGoiThau));
}

<style>
    #list_address li {
        list-style-type: none;
    }

    .error {
        color: red;
    }

    .field-required .dropdown-display-label {
        border: 1px solid rgba(22, 49, 94,1);
    }
</style>

@*<script src="https://www.google.com/recaptcha/api.js?hl=vi" async defer></script>*@


<div class="top_heading  _out">
    <div class="top_site_main " style="color: rgb(255, 255, 255); background-image: url('/Content/Images/gioi-thieu-fecon.jpg'); padding-top: 140px;">
        <span class="overlay-top-header" style="background: rgba(0,0,0,0.5); box-shadow: 0 3px 10px rgb(0 0 0 / 0.2);"></span>
    </div>
    <div class="breadcrumbs-wrapper">
        <div class="container">
            @if (lang == "vi")
            {
                <ul itemprop="breadcrumb" itemscope="" id="breadcrumbs" class="breadcrumbs">
                    <li itemprop="itemListElement"><a href="https://coteccons.vn/"><span>TRANG CHỦ</span></a></li>
                    <li itemprop="itemListElement"><span>ĐĂNG KÝ</span></li>
                </ul>
            }
            else
            {
                <ul itemprop="breadcrumb" itemscope="" id="breadcrumbs" class="breadcrumbs">
                    <li itemprop="itemListElement"><a href="https://coteccons.vn/"><span>HOME</span></a></li>
                    <li itemprop="itemListElement"><span>SIGN UP</span></li>
                </ul>
            }
        </div>
    </div>
</div>
