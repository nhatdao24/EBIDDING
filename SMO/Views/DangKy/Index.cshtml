                    <script>
                        function addCommas(str) {
                            return str.replace(/^0+/, '').replace(/\D/g, "").replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                        }

                        function formatNumber(id) {
                            var val = document.getElementById(id).value;
                            document.getElementById(id).value = addCommas(val);
                        }
                    </script>

