@model SMO.Service.EB.BidService

@{ 
    Layout = "~/Views/Shared/_Layout_Portal.cshtml";
}

<div class="page-heading">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h1>DANH SÁCH GÓI THẦU</h1>
            </div>
            <div class="col-md-6">
                <ul class="bread-crumb">
                    <li>
                        <a title="HOME" href="/">
                            Trang chủ
                        </a>
                    </li>
                    <li class="separator">
                        &#47;
                    </li>
                    <li>
                        Gói thầu
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<section class="blog-section">
    <div class="container">
        <div class="col-md-3">
            <div class="sidebar">
                <div class="widget widget-search">
                    <div class="widget-title">
                        <h4>Tìm kiếm theo tên</h4>
                    </div>
                    <form class="search-form" action="search" method="post">
                        <input type="search" class="search-field" placeholder="Tên gói thầu..." value="" name="s" title="Search for:">
                        <button type="submit">
                            <i class="icon-search"></i>
                        </button>
                    </form>
                </div>

                <div class="widget widget-cats">
                    <div class="widget-title">
                        <h4>TRẠNG THÁI</h4>
                    </div>
                    <ul>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            GÓI THẦU ĐƯỢC MỜI
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            ĐANG MỞ THẦU
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            ĐÃ KẾT THÚC
                        </li>
                    </ul>
                </div>

                <div class="widget widget-cats">
                    <div class="widget-title">
                        <h4>Loại gói thầu</h4>
                    </div>
                    <ul>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            VẬT TƯ
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            MÁY MÓC
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            THI CÔNG
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            XÂY LẮP
                        </li>
                        <li>
                            <input type="checkbox" style="width:16px; height: 16px;">
                            VẬN CHUYỂN
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            @foreach (var bid in Model.ObjList)
            {
                if (bid.ListNew.Count > 0)
                {
                    <div class="row">
                        <div class="col-md-5">
                            <div class="project-pics">
                                <a href="/GoiThau/ChiTiet/@bid.PKID">
                                    <img src='@bid.ListNew.FirstOrDefault().IMAGE_PATH' alt='img' style="width: 100%">
                                </a>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="project-info">
                                <h4>@bid.ListNew.FirstOrDefault().TIEU_DE</h4>
                                <p>
                                    <strong>Loại gói thầu</strong>:&nbsp;&nbsp; @bid.TYPE<br>
                                    <strong>Ngày mở thầu</strong>:&nbsp;&nbsp; @(bid.NGAY_MO_THAU.HasValue ? bid.NGAY_MO_THAU.Value.ToString(Global.DateToStringFormat) : "")<br>
                                    <strong>Ngày đóng thầu</strong>:&nbsp;&nbsp; @(bid.NGAY_DONG_THAU.HasValue ? bid.NGAY_DONG_THAU.Value.ToString(Global.DateToStringFormat) : "")<br>
                                </p>
                                <p>
                                    @bid.ListNew.FirstOrDefault().MO_TA_NGAN
                                </p>
                            </div>
                        </div>
                    </div>
                }
                <hr />
            }
        </div>
    </div>
</section>

<script type="text/javascript">
    $("#menu-item-goithau").attr("class", "menu-item menu-item-type-post_type menu-item-object-page current-menu-item page_item page-item-125 current_page_item current_page_parent menu-item-127 tc-menu-item tc-menu-depth-0 tc-menu-align-left tc-menu-layout-default");
</script>