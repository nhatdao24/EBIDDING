/* Sử dụng Flexbox để chia 3 cột ngang */
.footer-flex-container {
    display: flex;
    justify-content: space-between;
    align-items: flex-start; /* Căn hàng trên cùng */
    flex-wrap: wrap; /* Cho phép xuống dòng trên mobile */
    gap: 30px;
}

/* Định dạng các cột */
.footer-col-info {
    flex: 2; /* Cột thông tin rộng hơn chút */
    min-width: 300px;
}

.footer-col-social,
.footer-col-app {
    flex: 1;
    min-width: 200px;
}

/* Định dạng các dòng thông tin liên hệ */
        .contact-line,
        .contact-line span,
        .contact-line i,
        .contact-line a {
            color: #ffffff !important;
            text-decoration: none !important; /* Bỏ gạch chân cho email/link */
        }

            /* Đảm bảo icon luôn trắng kể cả khi không có class contact-icon */
            .contact-line i {
                margin-right: 10px;
                font-size: 16px;
                display: inline-block;
                vertical-align: middle;
                color: #ffffff !important;
            }

        .contact-icon {
            position: relative;
            top: 1px;
        }
        .app-download-container {
            display: flex !important;
            align-items: flex-start;
            gap: 15px; /* Khoảng cách giữa nút app và QR */
            margin-top: 15px;
        }

        /* Cột chứa 2 nút tải app (xếp dọc) */
        .app-buttons-stack {
            display: flex !important;
            flex-direction: column !important;
            gap: 10px; /* Khoảng cách giữa 2 nút app */
        }

        /* Kích thước nút App (App Store/Google Play) */
        .app-button-img {
            width: 150px !important; /* Độ rộng nút app theo mẫu VietinBank */
            height: auto;
            border-radius: 6px;
            display: block;
            border: 1px solid rgba(255,255,255,0.1); /* Viền mờ cho chuyên nghiệp */
        }
/* Tiêu đề cột (Kết nối, Tải ứng dụng) */
        .footer-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 20px;
            margin-top: 0; /* Loại bỏ margin mặc định của thẻ H */
            text-transform: uppercase;
            color: #ffffff !important;
        }
        .vtb-footer a {
            color: #ffffff !important;
            text-decoration: none;
        }

            .vtb-footer a:hover {
                color: #ffffff; /* Hoặc màu nhẹ hơn khi di chuột vào */
                text-decoration: underline;
            }
        .contact-icon {
            margin-right: 10px;
            font-size: 16px;
            position: relative;
            top: 3px;
            color: #ffffff !important; /* Đảm bảo icon cũng màu trắng */
        }
/* ================= SOCIAL ICONS (Giống hệt Angular) ================= */
.social-icons {
    display: flex;
    gap: 20px;
}

.icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.25s ease;
    text-decoration: none !important;
}

.icon-wrapper:hover {
    transform: translateY(-3px);
}

/* Sử dụng SVG trực tiếp để đảm bảo icon giống hệt mẫu */
.icon-wrapper svg {
    width: 28px;
    height: 28px;
    fill: #fff;
}

/* Màu nền cụ thể cho từng mạng xã hội */
.bg-facebook { background-color: #1877f2; }
.bg-youtube { background-color: #ff0000; }
.bg-tiktok { background-color: #000000; }


/* ================= APP DOWNLOAD SECTION ================= */
        /* Container chung cho nút App Store và Google Play */
        .app-button-complex {
            position: relative;
            display: block;
            width: 156px;
            height: 47px;
            margin-bottom: 10px;
            text-decoration: none !important;
        }

        /* Chữ "Tải ứng dụng tại" - Dùng chung cho cả 2 nút */
        .app-label-top {
            position: absolute;
            left: 48px; /* Căn lề trái để tránh đè lên logo bên trái */
            top: 5px; /* Khoảng cách từ đỉnh nút xuống */
            font-size: 10px;
            color: #fff;
            white-space: nowrap;
            font-family: Arial, sans-serif;
            opacity: 0.9;
            z-index: 3;
            line-height: 1;
        }

        /* Điều chỉnh riêng cho Google Play nếu cần */
        .gp-label {
            left: 47px;
            top: 5px;
        }

        /* Các thành phần logo và chữ của Google Play */
        .gp-logo-icon {
            position: absolute;
            left: 11px;
            top: 8px;
            width: 30px;
            height: 28px;
            z-index: 2;
        }

        .gp-brand-text {
            position: absolute;
            left: 47px;
            top: 19px;
            width: 99px;
            height: 21px;
            z-index: 2;
        }

        /* Container chứa cả 2 nút và QR */
        .app-download-wrapper {
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .app-buttons-stack {
            display: flex;
            flex-direction: column;
        }
