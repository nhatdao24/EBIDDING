@model SMO.Service.ReportService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("ResultBaoCaoThongKeGoiThau", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FormId)
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> BÁO CÁO THỐNG KÊ GÓI THẦU</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdAdd", "Tìm kiếm", string.Format("Forms.SubmitForm('{0}');", Model.FormId), "Alt+N", "search")
                        </div>
                    </div>
                    <div class="page-search-advance row m-l-0 m-r-0 m-b-10">
                        <div class="col-lg-3 col-xs-12">
                            <label>Đơn vị</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.CompanyCode, SelectListUtilities.GetCompanyCode(), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-lg-3 col-xs-12 input-daterange">
                            <label>Ngày mở thầu</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.NgayMoThau_TuNgay, new { @data_val = false, @placeholder = "Từ ngày" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.NgayMoThau_DenNgay, new { @data_val = false, @placeholder = "Đến ngày" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-xs-12 input-daterange">
                            <label>Ngày đóng thầu</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.NgayDongThau_TuNgay, new { @data_val = false, @placeholder = "Từ ngày" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.NgayDongThau_DenNgay, new { @data_val = false, @placeholder = "Đến ngày" })
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-3 col-xs-12 input-daterange">
                            <label>Ngày tạo</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.NgayTao_TuNgay, new { @data_val = false, @placeholder = "Từ ngày" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.NgayTao_DenNgay, new { @data_val = false, @placeholder = "Đến ngày" })
                                </div>
                            </div>
                        </div>

                        <div class="clearfix"></div>

                        <div class="col-lg-3 col-xs-12">
                            <label>Loại gói thầu</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.LoaiGoiThau, SelectListUtilities.GetBidType(isAddBlank: true), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-lg-3 col-xs-12">
                            <label>Dự án</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.DuAn, SelectListUtilities.GetAllProject(true), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Trạng thái</label>
                            <div class="form-group">
                                <select name="@Html.NameFor(m => m.TrangThaiGoiThau)" data-container="body"
                                        data-live-search="true"
                                        class="selectpicker show-tick dropdown form-control">
                                    <option value="">-</option>
                                    <option value="01">Khởi tạo</option>
                                    <option value="02">Chờ phê duyệt</option>
                                    <option value="03">Từ chối</option>
                                    <option value="05">Đã phê duyệt</option>\
                                    <option value="06">Hủy</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Giai đoạn</label>
                            <div class="form-group">
                                <select name="@Html.NameFor(m => m.GiaiDoan)" data-container="body"
                                        data-live-search="true"
                                        class="selectpicker show-tick dropdown form-control">
                                    <option value="">-</option>
                                    <option value="01">Khởi tạo</option>
                                    <option value="02">Nộp hồ sơ</option>
                                    <option value="03">Chấm thầu</option>
                                    <option value="04">Chọn nhà thầu</option>\
                                    <option value="05">Đóng thầu</option>
                                    <option value="06">Vòng tiếp theo</option>
                                    <option value="07">Hủy gói thầu</option>
                                </select>
                            </div>
                        </div>

                        <div class="clearfix"></div>

                        <div class="col-md-3 col-xs-12">
                            <label>Người tạo</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.NguoiTaoGoiThau, SelectListUtilities.GetAllUserFecon(true), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body", @data_val = false })
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Mã|Tên gói thầu</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.TenGoiThau)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>MST|Tên|Email nhà thầu</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.MaNhaThau)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Giá trị gói thầu</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.GiaTriGoiThau_From, new { @data_val = false, @placeholder = "Từ" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.GiaTriGoiThau_To, new { @data_val = false, @placeholder = "Đến" })
                                </div>
                            </div>
                        </div>

                        <div class="clearfix"></div>

                        <div class="col-md-3 col-xs-12">
                            <label>Số vòng đấu thầu</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.SoVongDauThau_From, new { @data_val = false, @placeholder = "Từ" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.SoVongDauThau_To, new { @data_val = false, @placeholder = "Đến" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-3 col-xs-12">
                            <label>Số nhà thầu tham gia</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.SoNhaThauThamGia_From, new { @data_val = false, @placeholder = "Từ" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.SoNhaThauThamGia_To, new { @data_val = false, @placeholder = "Đến" })
                                </div>
                            </div>
                        </div>


                    </div>
                    <div id="divResult">

                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/javascript">
        $(function () {
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");

            $('.input-daterange').datepicker({
                format: "dd/mm/yyyy",
                maxViewMode: 2,
                autoclose: true,
                keyboardNavigation: false,
                todayBtn: "linked",
                clearBtn: true,
                todayHighlight: true,
                language: "vi"
            });
        });
    </script>
</div>










