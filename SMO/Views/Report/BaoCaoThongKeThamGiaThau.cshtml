@model SMO.Service.ReportService
@{
    Model.ViewId = Guid.NewGuid().ToString();
    Model.FormId = Guid.NewGuid().ToString();
}
<div id='@Model.ViewId' class="container-fluid child-content">
    @using (Ajax.BeginForm("ResultBaoCaoThongKeThamGiaThau", null, FormDataUtils.GetAjaxOptions(Model.ViewId), new { @id = Model.FormId }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.FormId)
        <div class="card border-grey">
            <div class="body" style="padding-top: 0px;">
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active">
                        <a style="padding-left:0px"><i class="material-icons col-fecon">clear_all</i> BÁO CÁO THỐNG KÊ THAM GIA THẦU</a>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="page-function">
                        <div class="page-function-button m-r-20">
                            @Html.MyButton("cmdAdd", "Tìm kiếm", string.Format("Forms.SubmitForm('{0}');", Model.FormId), "Alt+N", "search")
                        </div>
                    </div>
                    <div class="page-search-advance row m-l-0 m-r-0 m-b-10">
                        <div class="col-md-4 col-xs-12">
                            <label>MST|Tên|Email nhà thầu</label>
                            <div class="form-group">
                                <div class="form-line">
                                    @Html.MyTextBoxFor(m => m.MaNhaThau)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12">
                            <label>Dự án</label>
                            <div class="form-group">
                                @Html.MyDropDownListFor(m => m.DuAn, SelectListUtilities.GetAllProject(), new { @data_live_search = "true", @class = "selectpicker show-tick", @data_container = "body" })
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12 input-daterange">
                            <label>Ngày mở thầu</label>
                            <div class="form-group">
                                <div class="form-line" style="float:left; width: 49%; margin-right:2px;">
                                    @Html.MyTextBoxFor(m => m.NgayMoThau_TuNgay, new { @data_val = false, @placeholder = "Từ ngày" })
                                </div>
                                <div class="form-line" style="float:left; width: 49%;">
                                    @Html.MyTextBoxFor(m => m.NgayMoThau_DenNgay, new { @data_val = false, @placeholder = "Đến ngày" })
                                </div>
                            </div>
                        </div>

                        <div class="clearfix"></div>

                        <div class="col-md-4 col-xs-12">
                            <label>Trạng thái tham gia</label>
                            <div class="form-group">
                                <select name="@Html.NameFor(m => m.TrangThaiThamGia)" data-container="body"
                                        data-live-search="true"
                                        class="selectpicker show-tick dropdown form-control">
                                    <option value="">-</option>
                                    <option value="1">Đã tham gia</option>
                                    <option value="2">Chờ xác nhận</option>
                                    <option value="3">Từ chối</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12">
                            <label>Trạng thái nộp hồ sơ</label>
                            <div class="form-group">
                                <select name="@Html.NameFor(m => m.TrangThaiNopHoSo)" data-container="body"
                                        data-live-search="true"
                                        class="selectpicker show-tick dropdown form-control">
                                    <option value="">-</option>
                                    <option value="Y">Đã nộp</option>
                                    <option value="N">Chưa nộp</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4 col-xs-12">
                            <label>Kết quả thầu</label>
                            <div class="form-group">
                                <select name="@Html.NameFor(m => m.KetQua)" data-container="body"
                                        data-live-search="true"
                                        class="selectpicker show-tick dropdown form-control">
                                    <option value="">-</option>
                                    <option value="Y">Trúng thầu</option>
                                    <option value="N">Không trúng hoặc Đang chọn</option>
                                </select>
                            </div>
                        </div>


                    </div>
                    <div id="divResult">

                    </div>
                </div>
            </div>
        </div>
    }

    <script type="text/javascript">
        $(function () {
            Forms.CompleteUI();
            Forms.SubmitByEnter("@Model.FormId");

            $('.input-daterange').datepicker({
                format: "dd/mm/yyyy",
                maxViewMode: 2,
                autoclose: true,
                keyboardNavigation: false,
                todayBtn: "linked",
                clearBtn: true,
                todayHighlight: true,
                language: "vi"
            });
        });
    </script>
</div>








